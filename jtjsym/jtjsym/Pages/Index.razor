@page "/"
@using Microsoft.FluentUI.AspNetCore.Components
@using jtjsym.Services
@inject IJSRuntime JS

<PageTitle>夜游桃花源</PageTitle>

<header class="home-header">
    <h1>欢迎来到夜游桃花源</h1>
    <p class="home-subtitle">木鱼、计时器、四款小游戏——用来打发时间的小站。</p>
</header>

<main class="home-main">
    <section class="home-card home-card--intro" aria-label="站点简介">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <h2 class="card-title">关于这里</h2>
                <p class="card-desc">个人小站，所有内容都在浏览器里跑，不存任何数据。</p>
            </div>
        </FluentCard>
    </section>

    <NavLink class="home-card" href="counter">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <FluentIcon Value="@(new Icons.Regular.Size32.TapSingle())" />
                <h3 class="card-title">按下试试</h3>
                <p class="card-desc">电子木鱼，点一下，功德 +1。</p>
            </div>
        </FluentCard>
    </NavLink>

    <NavLink class="home-card" href="loveTime">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <FluentIcon Value="@(new Icons.Regular.Size32.Heart())" />
                <h3 class="card-title">爱情计时器</h3>
                <p class="card-desc">相识、相爱、相守，精确到秒。</p>
            </div>
        </FluentCard>
    </NavLink>

    <NavLink class="home-card" href="game_2048">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <FluentIcon Value="@(new Icons.Regular.Size32.SquareMultiple())" />
                <h3 class="card-title">2048</h3>
                <p class="card-desc">方向键 + 屏幕按钮，合到 2048。</p>
            </div>
        </FluentCard>
    </NavLink>

    <NavLink class="home-card" href="tetris">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <FluentIcon Value="@(new Icons.Regular.Size32.TetrisApp())" />
                <h3 class="card-title">俄罗斯方块</h3>
                <p class="card-desc">消行、升级，手机竖屏也能玩。</p>
            </div>
        </FluentCard>
    </NavLink>

    <NavLink class="home-card" href="minesweeper">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <FluentIcon Value="@(new Icons.Regular.Size32.Flag())" />
                <h3 class="card-title">扫雷</h3>
                <p class="card-desc">初级 9×9、中级 16×16，长按插旗。</p>
            </div>
        </FluentCard>
    </NavLink>

    <NavLink class="home-card" href="lianliankan">
        <FluentCard Style="width:100%;height:100%">
            <div class="card-body">
                <FluentIcon Value="@(new Icons.Regular.Size32.PuzzlePiece())" />
                <h3 class="card-title">连连看</h3>
                @* 副行读的是本地榜（方案 A）：预渲染先画"今日还没通关"，交互实例读到纪录再改 *@
                <p class="card-desc llk-card-desc">@llkSubtitle</p>
            </div>
        </FluentCard>
    </NavLink>
</main>

<footer class="site-footer">
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">陕ICP备2024056488号</a>
</footer>

@code {
    private readonly int issue = LianliankanCore.IssueFor(DateTimeOffset.UtcNow);

    /// <summary>副行默认文案。期号文案统一由 <see cref="LlkCopy"/> 拼（与页面标题同一处来源）。</summary>
    private string llkSubtitle = LlkCopy.HomeNoBest(LianliankanCore.IssueFor(DateTimeOffset.UtcNow));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;                      // 只由交互实例读盘（预渲染实例没有 JSRuntime）

        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", LlkKeys.Best);
            var best = LianliankanCore.TryParseBest(raw, issue);
            var next = best is null ? LlkCopy.HomeNoBest(issue) : LlkCopy.HomeWithBest(issue, best.Value);
            if (next != llkSubtitle)
            {
                llkSubtitle = next;
                StateHasChanged();
            }
        }
        catch (JSException) { }                        // 存储被禁：保持"今日还没通关"，卡片仍然可点
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }
}
