@page "/tetris"
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Timers
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>俄罗斯方块</PageTitle>

<h1 class="tetris-title">俄罗斯方块</h1>

<div class="tetris-container">
    <!-- 上部区域：画布 + 右侧信息面板 -->
    <div class="top-area">
        <!-- 左侧游戏画布区域 - 占3/4 -->
        <div class="game-area">
            <div class="game-canvas">
                @for (int row = 0; row < GRID_HEIGHT; row++)
                {
                        <div class="grid-row">
                        @for (int col = 0; col < GRID_WIDTH; col++)
                        {
                            var bgColor = gameGrid[row][col] > 0 ? BLOCK_COLORS[gameGrid[row][col] - 1] : GRID_COLOR;
                            var borderColor = gameGrid[row][col] > 0 ? "#333" : "#1a1a1a";
                                    <div class="grid-cell" style="background-color: @bgColor; border-color: @borderColor;"></div>
                        }
                        </div>
                }
                <!-- 渲染当前方块 -->
                @if (currentPiece != null)
                {
                        <div class="current-piece-overlay" style="top: calc(var(--cell-size) * @(y)); left: calc(var(--cell-size) * @(x));">
                        @for (int row = 0; row < currentPiece.Length; row++)
                        {
                                    <div class="piece-row">
                                @for (int col = 0; col < currentPiece[row].Length; col++)
                                {
                                    if (currentPiece[row][col] == 1)
                                    {
                                                        <div class="piece-cell" style="background-color: @BLOCK_COLORS[currentIndex];"></div>
                                    }
                                    else
                                    {
                                                        <div class="piece-empty"></div>
                                    }
                                }
                                    </div>
                        }
                        </div>
                }
            </div>
        </div>

        <!-- 右侧信息面板 - 占1/4 -->
        <div class="side-panel">
            <div class="panel-content">
                <!-- 难度显示 -->
                <div class="info-row">
                    <span class="info-label">难度等级:</span>
                    <span class="info-value">@difficultyLevel</span>
                </div>

                <hr class="divider" />

                <!-- 分数显示 -->
                <div class="info-row">
                    <span class="info-label">分数:</span>
                    <span class="info-value">@score</span>
                </div>

                <!-- 最高分（D-23）。类名 best-score 与 2048 的 <p class="best-score"> 共用，
                     e2e 的 readBest() 靠这一个类名两页通吃（helpers.mjs），不再另造取数口径。
                     占位只到 isBestLoaded 为止：读完成前恒「—」，读完才可能是 0 或真实值。
                     ⚠ 本行之后**不要**再加 hr.divider —— 加一行已 +30px，divider 再 +13px。 -->
                <div class="info-row best-score">
                    <span class="info-label">最高分:</span>
                    <span class="info-value">@(isBestLoaded ? bestScore.ToString() : "—")</span>
                </div>

                <hr class="divider" />

                <!-- 下一方块预览 -->
                <span class="info-label">下一方块:</span>
                <div class="next-piece-preview">
                    @if (nextPiece != null)
                    {
                        @for (int row = 0; row < nextPiece.Length; row++)
                        {
                                    <div class="preview-row">
                                @for (int col = 0; col < nextPiece[row].Length; col++)
                                {
                                    var bgColor = nextPiece[row][col] == 1 ? BLOCK_COLORS[nextIndex] : "transparent";
                                                <div class="preview-cell" style="background-color: @bgColor;"></div>
                                }
                                    </div>
                        }
                    }
                    else
                    {
                            <div class="preview-empty">等待开始...</div>
                    }
                </div>

                <hr class="divider" />

                <!-- 游戏控制按钮 -->
                <div class="game-controls">
                    @if (!isPaused)
                    {
                            <FluentButton Class="game-btn control-btn pause-btn"
                                          @onclick="PauseGame"
                                          Disabled="@isGameOver">
                                暂停游戏
                            </FluentButton>
                    }
                    else
                    {
                            <FluentButton Class="game-btn control-btn" Style="background-color: #666;" Disabled="true">
                                已暂停
                            </FluentButton>
                            <FluentButton Class="game-btn control-btn continue-btn"
                                          @onclick="ResumeGame"
                                          Disabled="@isGameOver">
                                继续游戏
                            </FluentButton>
                    }

                    <FluentButton Class="game-btn control-btn restart-btn"
                                  @onclick="RestartGame">
                        重新开始
                    </FluentButton>
                </div>

                @if (isGameOver)
                {
                        <div class="game-over-text">
                            游戏结束!
                        </div>
                }
            </div>
        </div>
    </div>

    <!-- 下部区域：操作按钮 -->
    <div class="bottom-area">
        <div class="control-buttons">
            <div class="direction-pad">
                <!-- 旋转按钮 -->
                <FluentButton Class="game-btn rotate-btn"
                              @onclick="RotatePiece"
                              Disabled="@(isGameOver || isPaused)">
                    旋转
                </FluentButton>
                <!-- 方向键 -->
                <div class="dir-buttons">
                    <FluentButton Class="game-btn direction-btn"
                                  @onclick="() => MovePiece(-1, 0)"
                                  Disabled="@(isGameOver || isPaused)">
                        ←
                    </FluentButton>
                    <FluentButton Class="game-btn direction-btn down-btn"
                                  @onpointerdown="OnDownButtonPress"
                                  @onpointerup="OnDownButtonRelease"
                                  @onpointerout="OnDownButtonRelease"
                                  @onpointerleave="OnDownButtonRelease"
                                  Disabled="@(isGameOver || isPaused)">
                        ↓
                    </FluentButton>
                    <FluentButton Class="game-btn direction-btn"
                                  @onclick="() => MovePiece(1, 0)"
                                  Disabled="@(isGameOver || isPaused)">
                        →
                    </FluentButton>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* 页面主标题：高度必须确定（行高 24 + 下边距 6 = 30px），因为下方容器的 min-height 要按它扣减。
       桌面与 ≤520px 两处 min-height 的 30px 必须与这里同步；改错时 D14-2 会在 7 档手机视口同时变红。
       不用 rfs 流式字号：默认 h1 外高在 320→1280 之间从 40.2 漂到 56，calc() 里跟不上。 */
    .tetris-title {
        font-size: 20px;
        line-height: 24px;
        margin: 0 0 6px;
        padding: 0;
        text-align: center;
    }

    /* 整体容器 */
    .tetris-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 10px;
        /* 30 = 标题行高 24 + 下边距 6；1.1rem = 17.6px，是 .content 的 padding-top，
           原先漏扣 → 任何视口恒溢 17.6px（1400×1000 实测 18px，P-023）。
           1.1rem 与 site.css 里 .content 的 padding 强耦合，改那边必须同步这里。 */
        min-height: calc(100dvh - 30px - 1.1rem);
        background-color: #0a0a0a;
        gap: 15px;
        /* 单一尺寸来源，三个上限取最小：
           ① 30px —— 桌面视觉封顶；
           ② (100vw - 78px)/10 —— 按宽度收缩：78 = px-4(48) + 容器 padding(20) + 画布边框(4) + 6px 余量；
           ③ (100dvh - 142px)/20 —— 按**高度**收缩（20 = GRID_HEIGHT），让 20 行进得去矮视口。
              142 的构成（844×390 实测逐项）：.content padding-top 17.6 + h1 24 + 下边距 6 + 容器 padding-top 10
              + 画布上下边框 4 + gap 15 + 操作区 55 + 容器 padding-bottom 10 = 141.6 ≈ 142。
           用 100dvh 不用 100vh：真机横屏浏览器工具栏伸缩时 100vh 高估可用高，格子偏大仍溢出
           （Playwright 的 viewport 恒等于 innerHeight，测试看不出差别）。 */
        --cell-size: min(30px, calc((100vw - 78px) / 10), calc((100dvh - 142px) / 20));
    }

    /* 上部区域：画布 + 信息面板 */
    .top-area {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        width: 80%;
        max-width: 600px;
        gap: 10px;
    }

    /* 游戏画布区域 - 占3/4 */
    .game-area {
        flex: 3;
        display: flex;
        justify-content: center;
    }

    /* 游戏画布 */
    .game-canvas {
        position: relative;
        background-color: #1a1a1a;
        border: 2px solid #333;
        display: inline-block;
    }

    .grid-row {
        display: flex;
    }

    .grid-cell {
        width: var(--cell-size);
        height: var(--cell-size);
        border: 1px solid;
        box-sizing: border-box;
    }

    /* 当前方块 */
    .current-piece-overlay {
        position: absolute;
        pointer-events: none;
    }

    .piece-row {
        display: flex;
    }

    .piece-cell {
        width: var(--cell-size);
        height: var(--cell-size);
        border: 1px solid #333;
        box-sizing: border-box;
    }

    .piece-empty {
        width: var(--cell-size);
        height: var(--cell-size);
        box-sizing: border-box;
    }

    /* 侧边信息面板 - 占1/4 */
    .side-panel {
        flex: 1;
        background-color: #1a1a1a;
        border: 2px solid #333;
        border-radius: 8px;
        padding: 12px;
        min-width: 110px;
        /* 预览格随主网格缩放，18px 封顶（= 30 × 0.6） */
        --preview-size: min(18px, calc(var(--cell-size) * 0.6));
    }

    .panel-content {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* 信息行 */
    .info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .info-label {
        color: #aaa;
        font-size: 13px;
    }

    .info-value {
        color: white;
        font-size: 16px;
        font-weight: bold;
    }

    /* 分隔线 */
    .divider {
        border: none;
        border-top: 1px solid #444;
        margin: 3px 0;
    }

    /* 下一方块预览 */
    .next-piece-preview {
        background-color: #0a0a0a;
        border: 1px solid #444;
        border-radius: 4px;
        padding: 8px;
        min-height: 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .preview-row {
        display: flex;
    }

    .preview-cell {
        width: var(--preview-size);
        height: var(--preview-size);
        border: 1px solid #444;
        display: inline-block;
        box-sizing: border-box;
    }

    .preview-empty {
        color: #666;
        padding: 8px;
        font-size: 12px;
    }

    /* 游戏控制按钮 */
    .game-controls {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 4px;
    }

    .control-btn {
        width: 100%;
        height: 36px;
        font-size: 14px;
    }

    .pause-btn {
        background-color: #0078D4;
    }

    .continue-btn {
        background-color: #107C10;
    }

    .restart-btn {
        background-color: #D83B01;
    }

    /* 游戏结束提示 */
    .game-over-text {
        color: #ff4444;
        font-size: 14px;
        font-weight: bold;
        text-align: center;
        margin-top: 6px;
        padding: 6px;
        background-color: rgba(255, 68, 68, 0.1);
        border-radius: 4px;
    }

    /* 下部区域：操作按钮 */
    .bottom-area {
        display: flex;
        justify-content: center;
        width: 100%;
        max-width: 600px;
    }

    .control-buttons {
        display: flex;
        justify-content: center;
    }

    .direction-pad {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .dir-buttons {
        display: flex;
        gap: 8px;
    }

    /* 通用按钮样式 */
    .game-btn {
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        transition: filter 0.2s, transform 0.2s;
    }

    /* 内部按钮：抹掉 FAST 的 padding/border，让宿主背景与圆角说话。
       fluent-button 有 Shadow DOM（内部是 class="control" / part="control" 的 button，
       自带 padding:0 10px / border:1px solid transparent），只改宿主的话
       40px 宽的方向键内宽只剩 20px。::part(control) 是唯一可靠入口。 */
    fluent-button.game-btn::part(control) {
        background: transparent;
        border: none;
        border-radius: 6px;
        padding: 0 4px;
        font: inherit;
        color: inherit;
        width: 100%;
        height: 100%;
    }

    /* :disabled 伪类不匹配自定义元素（fluent-button 不是表单元素，实测永不命中）
       → 全部改属性选择器 */
    .game-btn:hover:not([disabled]) {
        filter: brightness(1.1);
        transform: scale(1.05);
    }

    .game-btn:active:not([disabled]) {
        filter: brightness(0.9);
        transform: scale(0.95);
    }

    .game-btn[disabled] {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* 抵消 FAST 内部 .control 自带的 opacity:.3，保持禁用态 0.5 */
    fluent-button.game-btn[disabled]::part(control) {
        opacity: 1;
    }

    /* 旋转按钮 */
    .rotate-btn {
        width: 90px;
        height: 50px;
        background-color: #0078D4;
        font-size: 18px;
    }

    /* 方向按钮 */
    .direction-btn {
        width: 55px;
        height: 55px;
        background-color: #0078D4;
        font-size: 24px;
    }

    /* 向下按钮特殊样式 */
    .down-btn {
        background-color: #106EBE;
    }

    /* ==================== 响应式自适应 ==================== */

    /* L1：≤900px 放开 80% 宽度限制。
       .top-area 原为 80% + max-width 600px，横排硬性下限 424px（网格 304 + gap 10 + 面板 110），
       侧栏占 250px 后 781~856px 必然溢出；桌面 ≥901px 保持 80%，视觉零变化
       （641~767px 由 L2 兜底堆叠） */
    @@media (max-width: 900px) {
        .top-area {
            width: 100%;
        }
    }

    /* L2：只剩 641~767px 的"窄窗真空区"堆叠（P-023：上界由 780 收到 767）。
       横排硬性下限 424px 只要求 W ≥ 750px —— 实测 750/753/755/760/765/768 六档横排
       `scrollWidth == clientWidth`，侧栏压到 min-width:110px 地板仍不横向溢出，
       故原"留 15px 给竖滚动条 → 765"过于保守。取 767 的两个好处：
       ① iPad 竖屏 768 这一档改走横排，纵向溢出 26px 直接归零；
       ② 641~767 才是真正的窄窗，交给下面同一块的窄窗规则（含高度预算）。
       —— 原 ≤520px 段已撤销，交给 L3 的 Grid 重排接管 */
    @@media (min-width: 641px) and (max-width: 767px) {
        .top-area {
            width: 100%;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .game-area {
            flex: none;   /* 竖排时 flex:3 无意义，且干扰高度计算 */
            width: auto;
        }

        .side-panel {
            flex: none;
            box-sizing: border-box;                    /* 关键：否则外宽比网格多 28px */
            width: calc(var(--cell-size) * 10 + 4px);  /* +4px 对齐画布 4px 边框 */
            max-width: 100%;
            min-width: 0;
        }
    }

    /* L2b：堆叠态的高度预算（P-023 第二步）。
       堆叠后纵向固定开销从横排的 142px 涨到 480px —— 因为画布与侧栏由"并排"变成"上下"，
       侧栏实测 330.5px 全部落在纵向。故在 L2 区段内把 ③ 号上限换成 (100dvh - 480px)/20，
       并给 12px 地板：再矮就放弃"零滚动"，宁可滚也不给 3px 的格子。
       480 的实测分解（768×1024）：.content padding-top 17.6 + 标题 30 + 容器 padding 10
       + 画布上下边框 4 + 画布/侧栏 gap 8 + 侧栏 330.5 + 行 gap 15 + 底栏 55 + 容器 padding 10。
       （P-023 时侧栏是 300.5、常数 450；D-23 加「最高分」一行后侧栏 +30 → 330.5，常数同步 +30。
        700×1000 因此格子由 27.5 缩到 26，代价写进《现状》的 Tetris 布局备注。）
       ⚠ 只在 min-height:431px 生效：更矮的 641~767 视口由 L6 解除堆叠改回横排，
       那档继续用基础公式的 (100dvh - 142px)/20，不受本块影响（D14-10 的横屏四档即此区间）。 */
    @@media (min-width: 641px) and (max-width: 767px) and (min-height: 431px) {
        .tetris-container {
            --cell-size: min(30px, calc((100vw - 78px) / 10), max(12px, calc((100dvh - 480px) / 20)));
        }
    }

    /* L3：≤520px 手机 —— 左棋盘 / 右「信息 + 操作」，全部控件首屏可见、无需滚动。
       桌面 ≥521px 各档实测与本改动前逐项一致（canvas/panel/controls 的 x/y/w/h 全等） */
    @@media (max-width: 520px) {
        .tetris-container {
            display: grid;
            grid-template-columns: auto var(--side-col);
            grid-template-areas:
                "canvas panel"
                "canvas controls";
            align-content: start;
            justify-content: center;
            column-gap: 8px;
            row-gap: 8px;                     /* 覆盖容器原有 gap:15px，右栏更紧凑 */
            margin: 0 -24px;                  /* 满宽：抵消 article 的 px-4，把 48px 让给棋盘 */
            min-height: calc(100dvh - 74px - 30px);  /* 74 = 导航 56 + .content padding-top 17.6；30 = 标题行高 24 + 下边距 6 */
            --side-col: 132px;
            /* 170 = 容器 padding 20 + 画布边框 4 + 右栏 132 + 列间距 8 + 余量 6 */
            --cell-size: min(30px, calc((100vw - 170px) / 10));
        }

        /* 抹掉两个包装层，孙级直接成为 grid 项（razor 标记零改动） */
        .top-area,
        .bottom-area {
            display: contents;
        }

        .game-area {
            grid-area: canvas;
            align-self: start;
        }

        /* width/min-width 必须写：L2 的 calc(...) 与 max-width 会串到这里，导致面板比按钮区窄 10px */
        .side-panel {
            grid-area: panel;
            align-self: start;
            width: auto;
            min-width: 0;
            box-sizing: border-box;
            padding: 8px;
        }

        .control-buttons {
            grid-area: controls;
        }

        /* 信息面板紧凑化 */
        .next-piece-preview {
            min-height: 44px;
            padding: 6px;
        }

        .divider {
            margin: 2px 0;
        }

        .control-btn {
            height: 38px;
            font-size: 13px;
        }

        /* 操作区：旋转独占一行，←↓→ 一行三列（弹性等分） */
        .control-buttons {
            flex-direction: column;
            width: 100%;
            gap: 8px;
        }

        .direction-pad {
            flex-direction: column;
            gap: 8px;
            width: 100%;
        }

        .rotate-btn {
            width: 100%;
            height: 44px;
            font-size: 16px;
        }

        .dir-buttons {
            width: 100%;
            gap: 6px;
        }

        /* min-width:0 必写：否则 ←/→ 的 min-content(37.3) 会挤掉 ↓，三键变成 37.3/33.5/37.3 */
        .direction-btn {
            flex: 1;
            min-width: 0;
            width: auto;
            height: 52px;
            font-size: 20px;
        }
    }

    /* L4（≤400px 定宽缩档）已整段删除：新方案用 flex 等分，定宽会与之打架；
       132px 右栏在 320px 下实测仍有 6px 余量，不再需要 ≤360px 的收窄档 */

    /* L5：矮视口（横屏手机为主，h ≤ 430px）压缩侧栏与操作区。
       侧栏实测 300.5px 是这档的**真正高度约束**（画布缩到 12px 后 top-area 高度由面板决定，
       再缩格子对总高零收益，实测 A/B 组溢出同为 48px）。
       本块必须在 L3 之后：L3 的 .side-panel{padding:8px} / .control-btn{height:38px} 会被这里覆盖。
       与七档竖屏（h ≥ 568）无交集，D14-1/D14-2/D14-7 不受影响。
       ── D-23（最高分行）追加：新增一行 .info-row = **+30px 面板高度**（行高 24 + panel-content gap 6），
       横屏四档因此 812×375 / 740×360 / 667×375 全部纵向溢出（740×360 直接打红 D14-10b）。
       面板内边距与预览区已在 H-006 压到地板，还能回收的只有 gap / divider / 预览高度：
       gap 6→4 省 16（8 个子项）、divider 1px0→0 省 6（3 条）、预览 32→28 省 4 = 共 26px。 */
    @@media (max-height: 430px) {
        .tetris-container {
            padding: 6px;
        }

        .side-panel {
            padding: 6px;
        }

        /* D-23：为容纳「最高分」行回收纵向空间（见块首注释的分解） */
        .panel-content {
            gap: 4px;
        }

        .next-piece-preview {
            min-height: 28px;
            padding: 4px;
        }

        .control-btn {
            height: 28px;
            font-size: 12px;
        }

        .game-controls {
            gap: 3px;
            margin-top: 0;
        }

        .divider {
            margin: 0;   /* D-23：1px 0 → 0，3 条共省 6px */
        }
    }

    /* L6：641~767px 且矮视口 —— 解除 L2 的纵向堆叠，回到「画布左、面板右」。
       该区段是为「窄窗真空区」设计的堆叠，但横屏手机 667/740 宽正好落进来：
       堆叠后面板底到 970px，比 360px 视口高 610px，暂停/重开按钮根本滚不到。
       必须写在 L2 之后（同优先级靠源码顺序覆盖）；上界随 L2 一起收到 767（P-023），
       768~780 已天然走横排，不需要这里再解一次。 */
    @@media (min-width: 641px) and (max-width: 767px) and (max-height: 430px) {
        .top-area {
            flex-direction: row;
            align-items: flex-start;
            gap: 10px;
            width: auto;
        }

        .game-area {
            flex: none;
            width: auto;
        }

        .side-panel {
            flex: none;
            width: auto;
            min-width: 110px;
            max-width: none;
            box-sizing: border-box;
        }
    }
</style>

@code {
    private const int GRID_WIDTH = 10;
    private const int GRID_HEIGHT = 20;
    private const int INITIAL_SPEED = 1000;
    private const int ACCELERATION = 50;
    private const int SOFT_DROP_INTERVAL = 50;
    private bool isDisposed = false;

    // 键盘：window 级 JS 监听的模块句柄与回调引用（详见 wwwroot/js/gamekeyboard.js）
    private IJSObjectReference? keyModule;
    private DotNetObjectReference<Tetris>? keyRef;
    private int keyRegId;

    private readonly string[] BLOCK_COLORS = new string[]
    {
        "#00FFFF", "#0000FF", "#FFA500", "#FFFF00", "#00FF00", "#800080", "#FF0000"
    };
    private const string GRID_COLOR = "#1a1a1a";

    private readonly int[][][] SHAPES = new int[][][]
    {
        new int[][] { new int[] { 1, 1, 1, 1 } },
        new int[][] { new int[] { 1, 0, 0 }, new int[] { 1, 1, 1 } },
        new int[][] { new int[] { 0, 0, 1 }, new int[] { 1, 1, 1 } },
        new int[][] { new int[] { 1, 1 }, new int[] { 1, 1 } },
        new int[][] { new int[] { 0, 1, 1 }, new int[] { 1, 1, 0 } },
        new int[][] { new int[] { 0, 1, 0 }, new int[] { 1, 1, 1 } },
        new int[][] { new int[] { 1, 1, 0 }, new int[] { 0, 1, 1 } }
    };

    private int[][] gameGrid = Array.Empty<int[]>();
    private int[][]? currentPiece;
    private int[][]? nextPiece;
    private int x, y;
    private int currentIndex;
    private int nextIndex;
    private int score = 0;

    // ── 最高分（D-23）：localStorage 持久化，键名与 2048 的 jtjsym.g2048.best 同命名空间 ──
    // 两个标志刻意拆开：isBestReading 是"读只发生一次"的防重入闸；
    // isBestLoaded 是"读完成"= 占位解锁。2048 把两者挤在一根标志上（await 之前就置位），
    // 若照抄，await 期间任何一次重渲染都会把「—」画成「0」—— Tetris 有 1 秒一拍的
    // gameTimer 与 50ms 的 softDropTimer，窗口一旦被拉长（弱机 interop 慢）就会露 0。
    private const string BestKey = "jtjsym.tetris.best";
    private int bestScore = 0;
    private bool isBestReading = false;
    private bool isBestLoaded = false;

    private int difficultyLevel = 1;
    private int speed = INITIAL_SPEED;
    private bool isGameOver = false;
    private bool isPaused = false;
    private bool isSoftDropping = false;
    private System.Timers.Timer? gameTimer;
    private System.Timers.Timer? difficultyTimer;
    private System.Timers.Timer? softDropTimer;
    private readonly object timerLock = new object();

    protected override void OnInitialized()
    {
        InitializeGame();
        StartGame();
    }

    private void InitializeGame()
    {
        gameGrid = new int[GRID_HEIGHT][];
        for (int i = 0; i < GRID_HEIGHT; i++)
        {
            gameGrid[i] = new int[GRID_WIDTH];
        }
        score = 0;
        difficultyLevel = 1;
        speed = INITIAL_SPEED;
        isGameOver = false;
        isPaused = false;
        isSoftDropping = false;
    }

    private void StartGame()
    {
        NewPiece();
        StartTimers();
    }

    private void StartTimers()
    {
        StopTimers();

        lock (timerLock)
        {
            if (isDisposed) return;

            gameTimer = new System.Timers.Timer(speed);
            gameTimer.Elapsed += OnGameTimerElapsed;
            gameTimer.AutoReset = true;
            gameTimer.Start();

            difficultyTimer = new System.Timers.Timer(180000);
            difficultyTimer.Elapsed += OnDifficultyTimerElapsed;
            difficultyTimer.AutoReset = true;
            difficultyTimer.Start();
        }
    }

    private void StopTimers()
    {
        lock (timerLock)
        {
            if (gameTimer != null)
            {
                gameTimer.Stop();
                gameTimer.Elapsed -= OnGameTimerElapsed;
                gameTimer.Dispose();
                gameTimer = null;
            }

            if (difficultyTimer != null)
            {
                difficultyTimer.Stop();
                difficultyTimer.Elapsed -= OnDifficultyTimerElapsed;
                difficultyTimer.Dispose();
                difficultyTimer = null;
            }
        }

        StopSoftDrop();
    }

    private void StartSoftDrop()
    {
        if (isSoftDropping || isPaused || isGameOver) return;

        lock (timerLock)
        {
            if (isDisposed) return;

            isSoftDropping = true;
            softDropTimer = new System.Timers.Timer(SOFT_DROP_INTERVAL);
            softDropTimer.Elapsed += OnSoftDropTimerElapsed;
            softDropTimer.AutoReset = true;
            softDropTimer.Start();

            if (gameTimer != null)
            {
                gameTimer.Stop();
            }
        }
    }

    private void StopSoftDrop()
    {
        lock (timerLock)
        {
            isSoftDropping = false;

            if (softDropTimer != null)
            {
                softDropTimer.Stop();
                softDropTimer.Elapsed -= OnSoftDropTimerElapsed;
                softDropTimer.Dispose();
                softDropTimer = null;
            }

            if (!isPaused && !isGameOver && gameTimer != null && !isDisposed)
            {
                gameTimer.Start();
            }
        }
    }

    private async void OnGameTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (isDisposed) return;

        try
        {
            if (!isPaused && !isGameOver && !isSoftDropping)
            {
                await InvokeAsync(() =>
                {
                    if (!isDisposed) DropPiece();
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // 忽略已释放对象的错误
        }
    }

    private async void OnSoftDropTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (isDisposed) return;

        try
        {
            if (!isPaused && !isGameOver && isSoftDropping)
            {
                await InvokeAsync(() =>
                {
                    if (!isDisposed) SoftDropPiece();
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // 忽略已释放对象的错误
        }
    }

    private async void OnDifficultyTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (isDisposed) return;

        try
        {
            if (!isGameOver)
            {
                await InvokeAsync(() =>
                {
                    if (!isDisposed) IncreaseDifficulty();
                });
            }
        }
        catch (ObjectDisposedException)
        {
            // 忽略已释放对象的错误
        }
    }

    private void OnDownButtonPress() => StartSoftDrop();
    private void OnDownButtonRelease() => StopSoftDrop();

    private void NewPiece()
    {
        if (isDisposed) return;

        if (nextPiece == null)
        {
            nextIndex = Random.Shared.Next(SHAPES.Length);
            nextPiece = SHAPES[nextIndex];
        }

        currentIndex = nextIndex;
        currentPiece = nextPiece;
        nextIndex = Random.Shared.Next(SHAPES.Length);
        nextPiece = SHAPES[nextIndex];

        x = GRID_WIDTH / 2 - currentPiece[0].Length / 2;
        y = 0;

        if (CheckCollision(currentPiece, x, y))
        {
            GameOver();
        }
    }

    private void DropPiece()
    {
        if (isDisposed || currentPiece == null || isGameOver || isSoftDropping) return;

        if (!CheckCollision(currentPiece, x, y + 1))
        {
            y++;
        }
        else
        {
            LockPiece();
            ClearRows();
            NewPiece();
        }
        StateHasChanged();
    }

    private void SoftDropPiece()
    {
        if (isDisposed || currentPiece == null || isGameOver || !isSoftDropping) return;

        if (!CheckCollision(currentPiece, x, y + 1))
        {
            y++;
            score += 1;
            UpdateBestScore();   // 内存即时；**不落盘**（D-23：落盘只在消行/结束/重玩）
            StateHasChanged();
        }
        else
        {
            LockPiece();
            ClearRows();
            NewPiece();
            StopSoftDrop();
            StateHasChanged();
        }
    }

    private void MovePiece(int dx, int dy)
    {
        if (isDisposed || currentPiece == null || isGameOver || isPaused) return;

        if (!CheckCollision(currentPiece, x + dx, y + dy))
        {
            x += dx;
            y += dy;
            StateHasChanged();
        }
    }

    private void RotatePiece()
    {
        if (isDisposed || currentPiece == null || isGameOver || isPaused) return;

        int rows = currentPiece.Length;
        int cols = currentPiece[0].Length;
        int[][] rotated = new int[cols][];

        for (int i = 0; i < cols; i++)
        {
            rotated[i] = new int[rows];
            for (int j = 0; j < rows; j++)
            {
                rotated[i][j] = currentPiece[rows - 1 - j][i];
            }
        }

        if (!CheckCollision(rotated, x, y))
        {
            currentPiece = rotated;
            StateHasChanged();
        }
    }

    private bool CheckCollision(int[][] piece, int offX, int offY)
    {
        if (isDisposed) return true;

        for (int row = 0; row < piece.Length; row++)
        {
            for (int col = 0; col < piece[row].Length; col++)
            {
                if (piece[row][col] == 1)
                {
                    int newX = offX + col;
                    int newY = offY + row;

                    if (newX < 0 || newX >= GRID_WIDTH || newY >= GRID_HEIGHT)
                        return true;

                    if (newY >= 0 && gameGrid[newY][newX] > 0)
                        return true;
                }
            }
        }
        return false;
    }

    private void LockPiece()
    {
        if (isDisposed || currentPiece == null) return;

        for (int row = 0; row < currentPiece.Length; row++)
        {
            for (int col = 0; col < currentPiece[row].Length; col++)
            {
                if (currentPiece[row][col] == 1)
                {
                    int gridY = y + row;
                    int gridX = x + col;
                    if (gridY >= 0 && gridY < GRID_HEIGHT && gridX >= 0 && gridX < GRID_WIDTH)
                    {
                        gameGrid[gridY][gridX] = currentIndex + 1;
                    }
                }
            }
        }
    }

    private void ClearRows()
    {
        if (isDisposed) return;

        int rowsCleared = 0;
        for (int row = GRID_HEIGHT - 1; row >= 0; row--)
        {
            if (Array.TrueForAll(gameGrid[row], cell => cell > 0))
            {
                for (int r = row; r > 0; r--)
                {
                    gameGrid[r] = gameGrid[r - 1];
                }
                gameGrid[0] = new int[GRID_WIDTH];
                rowsCleared++;
                row++;
            }
        }

        if (rowsCleared > 0)
        {
            score += rowsCleared switch
            {
                1 => 100,
                2 => 300,
                3 => 600,
                4 => 1000,
                _ => 100 * rowsCleared
            };

            // 落盘点之一：消行是本作唯一的大额加分，顺带把软降攒下的零头一起固化
            UpdateBestScore();
            _ = PersistBestAsync();
        }
    }

    /// <summary>
    /// 最高分只在**内存里即时跟进**，不负责落盘（D-23）。
    /// 只增不减 ⇒ 重玩后 score 归零时自然不覆盖；也不必在 InitializeGame 里复位。
    /// </summary>
    private void UpdateBestScore()
    {
        if (score <= bestScore) return;
        bestScore = score;
    }

    /// <summary>
    /// 落盘点只有三处：消行后 / GameOver / 重玩。软降的 +1 在"固化"意义上是延时的，
    /// UI 值始终即时（实测：按住 1 秒 = score 16、best 16、localStorage 仍是 null）。
    /// </summary>
    private async Task PersistBestAsync()
    {
        try
        {
            // bestScore 在第一个 await 之前求值 ⇒ fire-and-forget 晚完成也写不到"后来的值"
            await JS.InvokeVoidAsync("localStorage.setItem", BestKey, bestScore);
        }
        catch (JSException) { }              // 隐私模式 / 配额超限
        catch (JSDisconnectedException) { }  // 切页 / 断线
        catch (ObjectDisposedException) { }  // 电路已释放（与 2048 的 WriteBestAsync 同口径）
    }

    private void IncreaseDifficulty()
    {
        // 单一收口（H-001）：暂停/结束期间一律不升级。
        // 必须在这里而不是只在 OnDifficultyTimerElapsed 里判 —— 那里加判断仍有
        // 「Stop 已执行、回调已入队」的窗口，而本方法是唯一真正改等级与 Interval 的地方。
        if (isDisposed || isPaused || isGameOver) return;

        difficultyLevel++;
        speed = Math.Max(100, speed - ACCELERATION);

        if (gameTimer != null)
        {
            gameTimer.Interval = speed;
        }
        StateHasChanged();
    }

    /// <summary>
    /// 暂停冻结一切：主下落 + 软降 + 难度计时器（D-04）。
    /// 语义决策（H-001 定稿）：System.Timers.Timer.Stop() 会作废本轮倒计时，Start() 从满周期重算，
    /// 即「暂停 179 秒后继续」会重新获得完整 180 秒 —— 符合「暂停冻结一切」的直觉，
    /// 代价是主动暂停可无限延后升级。接受：升级只是变难，延后无收益激励。
    /// 若日后要求「按累计游戏时长升级」，需换 Stopwatch 累计而非依赖 Interval，属另立条目。
    /// 线程口径：Stop()/Start() 本身线程安全，此处不加 timerLock（与既有 gameTimer?.Stop() 一致）；
    /// 真正的竞态窗口（Stop 与「回调已入队」之间）由 IncreaseDifficulty() 首行守卫关闭。
    /// </summary>
    private void PauseGame()
    {
        if (isDisposed) return;

        isPaused = true;
        gameTimer?.Stop();
        difficultyTimer?.Stop();   // 新增（H-001）：否则暂停期间照常 IncreaseDifficulty()
        StopSoftDrop();
        StateHasChanged();
    }

    private void ResumeGame()
    {
        if (isDisposed) return;

        isPaused = false;
        gameTimer?.Start();
        // 兜底：让 Resume 对 Interval 幂等。IncreaseDifficulty() 现在暂停期不会跑，
        // 但换了入口（未来新增）时这一行保证「继续后速度与当前等级一致」。
        if (gameTimer != null) gameTimer.Interval = speed;
        difficultyTimer?.Start();  // 新增（H-001）：与 PauseGame 成对，从满周期重新计时
        StateHasChanged();
    }

    private void RestartGame()
    {
        StopTimers();
        // 落盘点之三：必须排在 InitializeGame() 之前 —— 它会 score = 0。
        // （bestScore 本身不参与复位，这里提前只是让"写盘时机早于清零"成为显式事实，别让人以为依赖它。）
        _ = PersistBestAsync();
        InitializeGame();
        currentPiece = null;
        nextPiece = null;
        StartGame();
        StateHasChanged();
    }

    private void GameOver()
    {
        if (isDisposed) return;

        isGameOver = true;
        StopTimers();
        _ = PersistBestAsync();   // 落盘点之二：遮罩由本 circuit 渲染，写盘可达
        StateHasChanged();
    }

    /// <summary>
    /// 即有的同步释放逻辑（isDisposed = true + 停 3 个 Timer）。
    /// 注意：本类此前未实现任何 Dispose 接口，Blazor 从不调用它 —— 本次由 DisposeAsync 显式调用，
    /// 这个方法才第一次真正生效（D-13）。
    /// </summary>
    public void Dispose()
    {
        isDisposed = true;
        StopTimers();
    }

    // ───────────────────────── 键盘操作（D-02）─────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 仅交互实例会走到 firstRender=true，规避 ServerPrerendered 的预渲染实例
        if (!firstRender) return;

        // ① 读最高分（D-23）。**必须与键盘模块解耦**：旧写法是合并守卫
        //    `if (!firstRender || keyModule is not null) return;`，第二段逻辑一旦提前返回
        //    或 import 抛异常，最高分就永远读不到；反之键盘挂了也不该连累它。
        if (!isBestReading)
        {
            isBestReading = true;
            try
            {
                var raw = await JS.InvokeAsync<string?>("localStorage.getItem", BestKey);
                if (int.TryParse(raw, out var v) && v > 0) bestScore = v;
            }
            catch (JSException) { }              // 隐私模式 / 存储被禁：保持 0，游戏零降级
            catch (JSDisconnectedException) { }  // 切页 / 断线
            isBestLoaded = true;                 // 读完才解锁占位（顺序：必须在 await 之后）
            StateHasChanged();
        }

        // ② 键盘（原逻辑不动）
        if (keyModule is not null) return;

        keyRef = DotNetObjectReference.Create(this);
        keyModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gamekeyboard.js");

        // 复检：import 期间组件可能已被销毁（DisposeAsync 当时 keyModule 还是 null，什么都没卸）。
        // 继续 register 会由 register() 首句 removeListeners() 拆掉新页的监听并抢走 currentId。
        // 只能收窄窗口，不能证明消除；D02-9 守的是最终归属。
        if (isDisposed)
        {
            try { await keyModule.DisposeAsync(); }
            catch (JSDisconnectedException) { } catch (ObjectDisposedException) { } catch (JSException) { }
            keyModule = null;
            keyRef.Dispose();
            keyRef = null;
            return;
        }

        // Tetris：←/→ 允许按住连发（快速贴边需要）；↑ 旋转、↓ 软降不连发
        // （↓ 的连续下落由 softDropTimer 驱动，与浏览器 repeat 无关）
        keyRegId = await keyModule.InvokeAsync<int>("register", keyRef,
            new { repeatKeys = new[] { "ArrowLeft", "ArrowRight" } });
    }

    /// <summary>
    /// 注意：[JSInvokable] 不会自动重渲染。MovePiece/RotatePiece 内部各自 StateHasChanged()，
    /// StartSoftDrop/StopSoftDrop 由 softDropTimer 驱动刷新，故这里不再额外触发。
    /// </summary>
    [JSInvokable]
    public async Task OnKeyDown(string key)
    {
        await InvokeAsync(() =>
        {
            switch (key)
            {
                case "ArrowLeft":  MovePiece(-1, 0); break;
                case "ArrowRight": MovePiece(1, 0);  break;
                case "ArrowUp":    RotatePiece();    break;
                case "ArrowDown":  StartSoftDrop();  break;   // 自带 isSoftDropping 幂等守卫
            }
        });
    }

    [JSInvokable]
    public async Task OnKeyUp(string key)
    {
        if (key == "ArrowDown")
            await InvokeAsync(StopSoftDrop);
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();   // ★ 必须在首行：先置 isDisposed + 停 3 个 Timer（与 2048 的 disposed = true 对称）。
                     //   留在末尾时，两个 await 之间 isDisposed 仍是 false，Timer 照常回调 DropPiece/
                     //   SoftDropPiece/IncreaseDifficulty，连接已死时可能拖到秒级。
                     //   注意：不要顺手把 keyRegId = 0 也提到前面 —— unregister 传入旧 id 会短路，监听卸不掉。
        if (keyModule is not null)
        {
            // 两发 interop 各自 try：若 unregister 抛出，不能连带跳过 DisposeAsync ——
            // 否则 keyModule 被置 null，JS 侧对象引用表会漏一项
            try
            {
                await keyModule.InvokeVoidAsync("unregister", keyRegId);
            }
            catch (JSDisconnectedException) { /* 断线/关页，无需清理 */ }
            catch (ObjectDisposedException) { /* 电路已释放 */ }
            catch (JSException) { /* 防御性：本方法的两发 interop 都不该抛 JSException，与同文件其余 interop 的四件套保持同口径 */ }

            try
            {
                await keyModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (JSException) { }
            keyModule = null;
        }
        keyRef?.Dispose();
        keyRef = null;
    }
}
