@page "/lianliankan"
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using jtjsym.Services
@inject IJSRuntime JS
@inject LianliankanLeaderboard Board
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>连连看 · 每日一关</PageTitle>

@* 期号文案只由 LlkCopy 拼一次（《36》v2.1 §3.5）：要改"地球日"这个说法，改常量即可 *@
<h1 class="llk-title">@LlkCopy.IssueLabel(issue)</h1>

<div class="llk-container">
    <div class="llk-status">
        <p class="llk-stat llk-elapsed">用时：@elapsedSec 秒</p>
        @* H-020：最后 60 秒才出现的低干扰提示。**不改成倒计时** —— 全站计时口径都是正计时
           （扫雷/2048 同款），而 320 下这一行本来就贴着折行线，常驻一个数字会把它顶成两行。
           ⚠ 单独的 <span> 而不是塞进 .llk-elapsed：e2e 的 readElapsed 取该节点第一个数字，
             塞进去会让"剩 1 秒"被读成用时 1 秒（LL-08/43/44 都依赖那个读数）。 *@
        @if (RemainSec is { } remain)
        {
            <span class="llk-stat llk-remain">@LlkCopy.RemainTip(remain)</span>
        }
        @* 提示按钮进状态行（H-015）：整行 +4px（18 → 22），LL-11 的余量 58 → 54。
           用原生 <button> 而不是 FluentButton —— 后者 32px 高会把状态行直接撑到 32。
           次数由 Core 给（HintButton），页面不自己减。 *@
        <button class="llk-hint-btn" type="button"
                disabled="@HintDisabled"
                @onclick="OnHintClicked">@LlkCopy.HintButton(game.HintsLeft)</button>
        <p class="llk-stat llk-best">@(LlkCopy.BestLabel)：@(isBestLoaded ? FormatBest(best) : LlkCopy.NoRecord)</p>
    </div>

    @* 三条提示共用这一个槽：任何时刻最多一行（D-30）。
       各写一个 @if 会叠加 —— 恢复死局档时「已恢复上一局」与「无解自动重排」本来就同时为真，
       再叠一条失败反馈就是 3 行 / 73px，320×568 直接溢出 15px（实测内容高 510 + 73 = 583）。
       优先级：失败反馈 > 重排 > 恢复。重排是最紧急的信息，"计时已暂停"是点一下就知道的事。
       ⚠ 文案必须 ≤ 1 行（320px 下约 18 字）：LL-11 打开的是干净页面，看不见这一行。 *@
    @if (clickFeedback is not null)
    {
        <p class="session-tip llk-click-tip" role="status">@clickFeedback</p>
    }
    else if (showReshuffleTip)
    {
        <p class="session-tip llk-reshuffle-tip" role="status">@LlkCopy.ReshuffleTip</p>
    }
    else if (showResumeTip)
    {
        <p class="session-tip llk-resume-tip" role="status">@LlkCopy.ResumeTip</p>
    }

    <div class="llk-board-wrap">
        @* 48 格恒定存在：消除只是加 .is-gone（透明 + 缩小），不移除节点 ——
           盘面不会因为消除而重排，e2e 的 data-idx 也就永远指同一格 *@
        @* D-31：重排动画的两个挂点。data-llk-reshuffling 给 e2e 当"动画中"的唯一锚，
           aria-busy 给读屏软件同一语义（两者都不改布局）。
           ⚠ 属性名带 llk 前缀：《39》已建立 data-llk-* 专门标识"状态机标记"
           （data-llk-mode / data-llk-bend），而 data-idx / data-face 是"结构数据"那一族。 *@
        <div class="llk-board" role="grid" aria-label="连连看棋盘"
             data-llk-reshuffling="@(isReshuffling ? "1" : null)"
             aria-busy="@(isReshuffling ? "true" : null)">
            @for (var i = 0; i < LianliankanCore.CellCount; i++)
            {
                // ⚠ 先拷进局部量：Razor 的 @for 循环变量是同一个变量，lambda 捕获到的是终值
                //   （《34》C-58 实测：每格都去翻最后一格）
                var idx = i;
                var face = game.Cells[idx];
                // D-32：face==0 的格若本局曾有过脸，继续用原脸的 sprite 位置 ——
                //   is-gone 的 340ms 延迟期内 opacity 恒为 1，图案必须原地不动；
                //   否则消除后 21ms 就会顶着第 1 张脸静止 330ms（用户报的"消失前变成别的图案"）。
                // ⚠ 兜底必须是 (0,0)，**不能**落回 Position(0)：C# 里 -1 % 6 == -1 ⇒ --c:-1，
                //   负偏移会让 background-position 露出 sprite 边缘，比现状更糟。
                var showFace = face > 0 ? face : lastFace[idx];
                var pos = showFace > 0 ? LianliankanThemes.Position(showFace) : (Col: 0, Row: 0);
                var name = face > 0 ? LianliankanThemes.ById(face)?.Name : null;
                // H-016：族色只给兜底字牌左侧色条用（正常态无视觉后果）。
                // 一律给个合法颜色：写成空的自定义属性会让 CSS 的 var(--fc, 兜底) 失效。
                // ⚠ 不要改成"先把 --fc 拼成字符串变量、再用括号表达式插进 style"的写法：实测那种拼接
                //   会让 Razor 解析失败（49 个 CS 报错，整个 code 块被挤出类体、连 _Imports 的 using 都不生效）。
                var accent = face > 0 ? LianliankanThemes.ById(face)?.Accent : null;

                @* data-face 只在非空格上出现：它是"这张脸还在不在盘上"的唯一判据，
                   写成 data-face="0" 会让 LL-12 的 {1..24} 集合断言多出一个 0 *@
                <div class="llk-cell @CellClass(idx, face) @FaceClass(showFace)"
                     role="gridcell"
                     data-idx="@idx"
                     data-face="@(face > 0 ? face.ToString() : null)"
                     style="--c:@pos.Col;--r:@pos.Row;--fc:@(accent ?? "#8C8F96")"
                     aria-label="@(name ?? "空")"
                     @onclick="() => OnCellClickedAsync(idx)">
                    @if (face > 0)
                    {
                        @* 兜底字牌（H-016）：正常态 display:none，只有探测失败（.llk-no-sprite）时由 CSS 露出。
                           读屏语义走格子的 aria-label（全名），这里 aria-hidden 免得同一张脸被念两遍。
                           用条件渲染而非恒渲染空 span：空格子少一个节点。 *@
                        <span class="llk-face-fb" aria-hidden="true">@LlkCopy.ShortName(face)</span>
                    }
                </div>
            }
        </div>

        @* 首访玩法遮罩（H-015）：复用 .llk-overlay 骨架 —— absolute + inset:0，
           零纵向预算、天然挡点击。320 下内容高约 229 < wrap 364。
           只弹一次：rulesSeen 写 localStorage，点「开始」才写（关掉标签页算没看过）。 *@
        @if (showRules)
        {
            <div class="llk-overlay llk-rules" role="dialog" aria-label="连连看玩法">
                <h2 class="llk-overlay-title">@LlkCopy.RulesTitle</h2>
                @* 静态 mini 示例（3×2 小格 + 一条 2 拐虚线）：不引额外 JS，也不需要动画 *@
                <svg class="llk-rules-mini" viewBox="0 0 96 68" aria-hidden="true">
                    @for (var r = 0; r < 2; r++)
                    {
                        @for (var c = 0; c < 3; c++)
                        {
                            <rect x="@(8 + c * 26)" y="@(12 + r * 26)" width="22" height="22" rx="3"
                                  fill="#F3ECE1" stroke="#C9B7A8" stroke-width="1" />
                        }
                    }
                    <rect x="8" y="12" width="22" height="22" rx="3" fill="#E8C9A0" stroke="#B3423C" stroke-width="1.5" />
                    <rect x="60" y="38" width="22" height="22" rx="3" fill="#E8C9A0" stroke="#B3423C" stroke-width="1.5" />
                    <polyline points="19,23 19,4 71,4 71,49" fill="none" stroke="#B3423C"
                              stroke-width="2" stroke-dasharray="5 4" stroke-linejoin="round" stroke-linecap="round" />
                    <circle cx="19" cy="4" r="3" fill="#B3423C" />
                    <circle cx="71" cy="4" r="3" fill="#B3423C" />
                </svg>
                <p class="llk-rules-line">@LlkCopy.RulePair</p>
                <p class="llk-rules-line">@LlkCopy.RuleTurns</p>
                <p class="llk-rules-line">@LlkCopy.RuleHintLine</p>
                <p class="llk-rules-line">@LlkCopy.RuleHints</p>
                @* H-020：限时也要在规则里说，否则「时间到」是玩家第一次听说有这回事 *@
                <p class="llk-rules-line">@LlkCopy.RuleTime</p>
                <FluentButton Class="llk-overlay-btn" Appearance="Appearance.Accent" @onclick="OnRulesStartClicked">@LlkCopy.RulesStart</FluentButton>
            </div>
        }

        @if (game.IsCleared)
        {
            <div class="llk-overlay llk-win" role="dialog" aria-label="通关">
                <h2 class="llk-overlay-title">全部消除</h2>
                <p class="llk-overlay-sub">用时 @elapsedSec 秒 · @LlkCopy.BestLabel @FormatBest(best) 秒</p>

                @* H-021 结算行：三分支（首次 / 刷新纪录 + 差值 / 不加行）。文案由 LlkCopy.ClearNote 单点生成，
                   页面只决定"有没有这一行"。 ⚠ 不加行时不留空 <p> —— 遮罩的 gap 会把它算成一行空白。 *@
                @if (clearNote is not null)
                {
                    <p class="llk-clear-note" role="status">@clearNote</p>
                }

                @* H-018：留名入口。**不是必经路径** —— 不填直接「再来一局」也完全正常（榜上记「神秘嘉宾」）。
                   用裸 input 而不是 FluentTextField：后者是 shadow DOM 自定义元素，e2e 的 fill 打不到内层
                   input（只能 pressSequentially 硬敲），而这里是**唯一**需要 e2e 填字的地方。
                   D-40 / C-98：**失败不再静默** —— 偶发 IO 静默是对的，但永久性权限故障被静默抹成
                   "点了没反应"，把一次运维遗漏放大成了看起来像 bug 的黑洞。三态各有各的字。 *@
                @if (!submitted)
                {
                    <div class="llk-name-row">
                        <input class="llk-name-input" type="text" maxlength="12"
                               placeholder="@LlkCopy.NamePlaceholder" aria-label="你的名字"
                               @bind="nameInput" @bind:event="oninput" />
                        <button class="llk-name-btn" type="button" disabled="@isSubmitting"
                                @onclick="OnSubmitNameClicked">@LlkCopy.NameButton</button>
                    </div>
                    @if (submitError is not null)
                    {
                        <p class="llk-name-error" role="status">@submitError</p>
                    }
                    else if (submitNote is not null)
                    {
                        <p class="llk-name-note" role="status">@submitNote</p>
                    }
                }
                else
                {
                    <p class="llk-name-saved">@LlkCopy.LeaderboardSaved</p>
                }

                @* H-021：两个按钮并排（320 下实测余量 231px，不会挤压）。 *@
                <div class="llk-overlay-actions">
                    <FluentButton Class="llk-overlay-btn" Appearance="Appearance.Accent" @onclick="OnRestartClicked">@LlkCopy.PlayAgain</FluentButton>
                    <FluentButton Class="llk-overlay-btn" @onclick="OnBackToCalendarClicked">@LlkCopy.BackToCalendar</FluentButton>
                </div>
            </div>
        }

        @* H-020：超时遮罩。**不写 best、不进榜**（TryUpdateBest 只在胜利路径）——
           所以这里没有留名入口，也不该出现「本关最快」，否则读着像"超时也算成绩"。 *@
        @if (isTimedOut)
        {
            <div class="llk-overlay llk-timeout" role="dialog" aria-label="时间到">
                <h2 class="llk-overlay-title">@LlkCopy.TimeoutTitle</h2>
                <p class="llk-overlay-sub">@LlkCopy.TimeoutSub</p>
                <div class="llk-overlay-actions">
                    <FluentButton Class="llk-overlay-btn" Appearance="Appearance.Accent" @onclick="OnRestartClicked">@LlkCopy.PlayAgain</FluentButton>
                    <FluentButton Class="llk-overlay-btn" @onclick="OnBackToCalendarClicked">@LlkCopy.BackToCalendar</FluentButton>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* 类名统一 llk- 前缀：组件 style 块是全局的（《34》§4.3），不加前缀会与 2048/Tetris/扫雷 的类撞车 */
    .llk-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-top: 8px;
    }

    .llk-status {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 18px;
        margin: 0;
    }

    .llk-stat {
        margin: 0;
        font-size: .95rem;
    }

    /* H-020：最后 60 秒的剩余时间。**只在那一分钟出现**，所以它带来的折行只发生在
       "已经在赶时间"的时候 —— LL-11 打开的是干净页面（用时 0），看不见这条。
       用朱砂色而不是红底/闪烁：棋盘才是主视觉，状态行不该抢。 */
    .llk-remain {
        font-size: .9rem;
        font-weight: 600;
        color: #B3423C;
    }

    .llk-board-wrap {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    /* 棋盘尺寸零 vw 算术（《36》v2.1 §3.1）：轨道等分 ⇒ 格宽 = min(容器宽/6, 64px)，
       max-width 封顶后桌面上最多 384px 宽（格 59px），375 屏约 49px、320 屏约 42px。
       不写 min(32px, (100vw − 侧栏)/6) —— 那个公式把 250px 侧栏算成了可用宽（《34》实测溢出 14~115px）。 */
    .llk-board {
        /* H-015：连接线 SVG 以棋盘为原点。不加 relative 会挂到 .llk-board-wrap 上，
           而棋盘在 wrap 里是 margin:0 auto 居中的 —— 两套坐标差一个横向偏移，线会整条跑偏。 */
        position: relative;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 6px;
        width: 100%;
        max-width: min(100%, 384px);
        margin: 0 auto;
        touch-action: manipulation;
        user-select: none;
        -webkit-user-select: none;
    }

    /* 头像走 sprite：1 次请求 + 1 次 decode（vs 24 个文件 24 次），且 background-position 是纯 CSS，
       预渲染阶段就定好了，不需要 JS 参与（对 LL-01「预渲染 HTML 已含 48 格」友好）。
       D-39 起这里是**两层**：第一层 sprite、第二层字牌图 —— 叠序本身就是降级机制，不需要 JS 参与判断。
       背景色兜底：两层都不画时格子也不塌成透明。 */
    .llk-cell {
        position: relative;
        /* D-39 / P1：格子比例零依赖。无条件先给一个由 padding 撑出来的正方形，新内核再用
           @@supports 覆盖回 aspect-ratio。
           ⚠ 顺序不能反：极老内核可能连 @@supports 都不认，那时"有条件的那条"会被整块丢弃，
             退回现状（只有 aspect-ratio ⇒ 高度塌成上下 border 的 2px，48 格变一条 58px 扁带）。 */
        height: 0;
        padding-bottom: 100%;                  /* 百分比相对包含块（= grid 列宽）⇒ 正方形 */
        min-width: 0;
        border: 0;                             /* 边框改 inset 阴影：真 border 会让兜底分支高 2px（比例 0.963） */
        box-shadow: inset 0 0 0 1px #C9B7A8;
        border-radius: 6px;
        overflow: hidden;
        cursor: pointer;
        background-color: #F3ECE1;
        /* D-39 / P2：两层背景。⚠ 两个必须照抄的点，漏一个就正好复现本次缺陷：
           ① 必须写 `var(--fb, none)`。某格没有 `--fb` 时，`url(...), var(--fb)` 会**整条**计算成
              none —— 连第一层 sprite 一起没（实测）。
           ② size / position 必须给**两组**。只给一组时浏览器按列表循环复用第一组 ⇒
              字牌层拿到 600% 400% 被放大 6 倍、位置错到看不见（实测 backgroundSize 两组同值）。 */
        background-image: url('/Images/llk/faces.png'), var(--fb, none);
        background-size: 600% 400%, 100% 100%;         /* 第一层 6 列 × 4 行；第二层整格铺满 */
        background-repeat: no-repeat;
        background-position: calc(var(--c) * 20%) calc(var(--r) * 33.3333%), 0 0;
    }

    /* 新内核分支：与 D-39 之前**逐像素相同**（52.33 × 52.33、1px 真边框）。
       LL-35 守的就是这一支没被兜底改动弄坏；兜底本身只能靠 LL-36 的静态判据守（见《50》§4.3）。 */
    @@supports (aspect-ratio: 1) {
        .llk-cell {
            height: auto;
            padding-bottom: 0;
            aspect-ratio: 1;
            border: 1px solid #C9B7A8;
            box-shadow: none;
        }
    }

    /* D-39 / P2：24 条 `.llk-face-N` 规则（每条给一个 --fb 自定义属性，值就是字牌 SVG data-URI），
       由 LlkCopy.FaceFallbackCss() 生成。
       为什么由 C# 给、不写死在这：写死等于把 24 个人名复制出第二份真源（U8 守的是 LlkCopy 那份）。
       为什么走 MarkupString：样式块是 raw text 元素，普通表达式会把 url() 里的引号转成 &quot;
       而样式表里不认实体 ⇒ 整条 background-image 失效。
       ⚠ 这段动态内容里**不许出现裸的尖括号**，注释里也一样：Blazor 写 markup 帧时交给 HTML 解析器，
         裸标签会被解析成元素、元素在样式块里不参与文本 ⇒ 整条 SVG 被吞掉（实测见 U12 注释①）。
         所以 FaceTileDataUri 输出的是整条百分号编码后的数据。 */
    @((MarkupString)LlkCopy.FaceFallbackCss())

    /* ── 兜底字牌（H-016 / D-33）────────────────────────────────────────────
       图没被画出来（无图模式 / 省流 / 拦截）时，sprite 的 48 格是**纯平色块、零纹理**，
       整盘看着像"格子还没加载完"。这里给一张能玩的字牌：固定配色 + 两字标。
       配色**不能**用族色底 + 白字：24 个 Accent 里有 14 个与 #FDF9F0 的对比度不足 4.5
       （最差 1.71，贺婉娘 #D8C070）—— "看不清"正是这条降级要解决的唯一问题。
       所以底色与字色写死（#F3ECE1 底 + #2B2B2B 字 = 12.07:1），族色只做左侧 4px 粗提示。
       色条刻意用**左侧竖条**而不是整圈描边：.is-selected 是 3px 内缩 outline，
       兜底牌面若用描边表族色，朱砂族会永久长得像被选中。 */
    .llk-cell .llk-face-fb { display: none; }

    /* 强制只显示字牌（JS 判定图被拦时）。多层叠已能自动降级，这条是"提前降级"的**显式开关**：
       把两层收成一层，sprite 连声明都不再给（取证字段 data-llk-sprite=fallback 同时落位）。
       ⚠ 别改回 `background-image: none`：那样字牌只剩绝对定位的 HTML span 一层，
         而这一层正是 D-34 记过的"老内核缺 inset 时贴边"的那层；字牌图不依赖定位，更稳。
       ⚠ 这里的 `var(--fb, none)` 同样不能省 —— 缺省值缺失会让整条声明无效，而不是退回上一层。 */
    .llk-board.llk-no-sprite .llk-cell {
        background-image: var(--fb, none);
        background-size: 100% 100%;
        background-position: 0 0;
    }

    .llk-board.llk-no-sprite .llk-cell .llk-face-fb {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        /* D-34：四向 longhand 而不是 `inset: 2px` —— shorthand 在老内核上可能整条不认，
           那时 top/right/bottom/left 保持 auto，绝对定位元素回落到**静态位置**（格内左上角），
           字牌仍可见但会贴边。拆开写各内核等价，零副作用。
           ⚠ 这条**不宣称**能解决"字牌完全不可见"：真机视频里 48 格是均匀深棕（不是米白 #F3ECE1），
           说明当时整页还处在启发式暗化下（D-33 现象 1），字牌被压成深底深字。 */
        top: 2px;
        right: 2px;
        bottom: 2px;
        left: 2px;
        border-radius: 4px;
        background: #F3ECE1;                    /* 固定米纸底，与 .llk-cell 的 background-color 同值 */
        color: #2B2B2B;                         /* 固定深字：12.07:1 */
        border-left: 4px solid var(--fc, #8C8F96);
        font-size: 13px;
        line-height: 1.05;
        letter-spacing: .5px;
        pointer-events: none;                   /* 点击仍落在格子上 */
    }

    .llk-cell.is-selected {
        outline: 3px solid #B3423C;
        outline-offset: -3px;
