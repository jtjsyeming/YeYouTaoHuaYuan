    /// </param>
    /// <remarks>
    /// 单独成方法而不拼在 <c>CellClass</c> 里：<c>CellClass</c> 的入参是 (idx, face)，
    /// 而这里要的是"曾经有过的那张脸"（<c>lastFace</c>）—— 混进去会让两个口径在同一个函数里打架。
    /// 也不写成 <c>class="… @(showFace &gt; 0 ? $"llk-face-{showFace}" : "")"</c>：
    /// 隐式表达式紧贴 <c>@(变量)</c> 的写法在 Razor 里出过 49 个 CS 错（C-72）。
    /// </remarks>
    private static string FaceClass(int showFace) => showFace > 0 ? $"llk-face-{showFace}" : "";

    // ───────────────────────── 失败反馈（D-30） ─────────────────────────

    /// <summary>
    /// 提示一条失败反馈，<see cref="FeedbackMs"/> 后自动清屏。
    /// <para>抖动与文案同生同灭：CSS 动画只播 300ms，class 留满 1.6s，
    /// 否则 e2e 的 <c>click() + sleep(220)</c> 只剩 80ms 窗口抓它。</para>
    /// <para><c>Task.Delay</c> 不会抛 <c>ObjectDisposedException</c>（那是 JS interop 的脾气），
    /// 这里只需要 <see cref="disposed"/> 双检 + 代际号。</para>
    /// </summary>
    private async Task ShowFeedbackAsync(string text, int a, int b, bool shake = true)
    {
        clickFeedback = text;
        // shake:false 时必须显式写 -1，不能"不赋值" —— 否则上一次的抖动会残留在新提示上
        // （③ 层是"有线但拐太多"，画面已经给了答案，再抖就是两个信号打架）
        shakeA = shake ? a : -1;
        shakeB = shake ? b : -1;
        var seq = ++feedbackSeq;
        if (!disposed) StateHasChanged();               // 先把提示画出来，再等 1.6s

        await Task.Delay(FeedbackMs);
        if (disposed || seq != feedbackSeq) return;     // 已被更新的一次接管，或已主动清零
        ClearFeedback();
        if (!disposed) StateHasChanged();
    }

    /// <summary>
    /// 清掉反馈、抖动与提示高亮。<b>成功消除必须调</b> —— 否则那句错误提示要等 1.6s 定时器到期才消失，
    /// 玩家看到的是"都消掉了还在报错"。
    /// <para><c>hintSeq++</c> 不能省：只把 <see cref="hintA"/> 置 -1 的话，在跑的 2s 延时到期时
    /// 还会再刷一次屏（无害但多一次渲染）；更要紧的是不递增就无法让"更早那一次"的延时失效。</para>
    /// </summary>
    private void ClearFeedback()
    {
        feedbackSeq++;                                  // 让在跑的延时回调失效（seq != feedbackSeq）
        clickFeedback = null;
        shakeA = -1;
        shakeB = -1;

        hintSeq++;
        hintA = -1;
        hintB = -1;
    }

    // ───────────────────────── 提示高亮（H-015） ─────────────────────────

    /// <summary>
    /// 把提示对的两格点亮 <see cref="HintPulseMs"/>。
    /// <para>时长与 CSS 的 <c>llk-hint-breathe 1s … 2</c> <b>严格对齐</b>：
    /// 动画自然结束的同时 class 被移除，不会看到"呼吸到一半被掐断"。</para>
    /// </summary>
    private async Task ShowHintPulseAsync((int R1, int C1, int R2, int C2) pair)
    {
        hintA = pair.R1 * LianliankanCore.Cols + pair.C1;
        hintB = pair.R2 * LianliankanCore.Cols + pair.C2;
        var seq = ++hintSeq;
        if (!disposed) StateHasChanged();

        await Task.Delay(HintPulseMs);
        if (disposed || seq != hintSeq) return;
        hintA = -1;
        hintB = -1;
        if (!disposed) StateHasChanged();
    }

    private async Task OnHintClicked()
    {
        if (HintDisabled) return;

        // ★ 先找对、找到才扣：反过来会在"死局瞬间点提示"白扣一次（理论死角，但扣了就是扣了）
        var pair = game.FindHintPair(selectedIdx >= 0 ? selectedIdx : null);
        if (pair is null)
        {
            showReshuffleTip = true;                    // 理论死角：不扣次数，给一条别的提示
            if (!disposed) StateHasChanged();
            return;
        }

        game.UseHint();
        ClearFeedback();                                // 上一条失败提示不该和"点亮新对"同屏
        ResumeClock();                                  // 会去点提示 = 已经在玩了，表走起来
        _ = ShowHintPulseAsync(pair.Value);

        await SaveSessionAsync();                       // 次数要落盘：刷新后仍是扣过的值（LL-19）
        if (!disposed) StateHasChanged();
    }

    // ───────────────────────── 连接线（H-015） ─────────────────────────

    /// <summary>
    /// 画一条连接线。<b>② 可连分支必须在 <c>game.Remove</c> 之前 await 这里</b>。
    /// <para>这条纪律仍然要守，但理由在 D-38 之后换了：旧理由是"<c>.is-gone</c> 的
    /// <c>transform: scale(.6)</c> 会让 <c>getBoundingClientRect</c> 返回缩小矩形，先删再画会把线连到格子内侧 40%"——
    /// 现在坐标是逐格实测中心、缩放不影响中心，所以线不会歪。真正的理由变成<b>语义</b>：
    /// 这条线画的是"刚刚还存在的两张牌"，先 <c>Remove</c> 再画等于在给两个空格画线。
    /// <b>别因为"中心准了"就把顺序调过来</b>，下一轮会有人这么问。</para>
    /// </summary>
    private async Task DrawLineAsync(LlkPath path, string mode)
    {
        try
        {
            lineModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/llkline.js");
            // 传 int[][] 而不是元组：ValueTuple 的 Item1/Item2 是**字段**，
            // System.Text.Json 默认只序列化属性 ⇒ 元组过来会变成 [{}]（老坑，别试）
            var pts = path.Points.Select(p => new[] { p.R, p.C }).ToArray();
            await lineModule.InvokeVoidAsync("drawPath", ".llk-board", pts, mode);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>清掉还在飘的线（④ 层用）。模块没加载过就不必调。</summary>
    private async Task ClearLinesAsync()
    {
        if (lineModule is null) return;

        try
        {
            await lineModule.InvokeVoidAsync("clear");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    // ───────────────────────── 玩法遮罩（H-015） ─────────────────────────

    private async Task OnRulesStartClicked()
    {
        showRules = false;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", LlkKeys.RulesSeen, "1");
        }
        catch (JSException) { }                         // 隐私模式：这次照样开局，下次再弹一次
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        if (!disposed) StateHasChanged();
    }

    // ───────────────────────── 生命周期 ─────────────────────────

    protected override void OnInitialized()
    {
        // 预渲染阶段就要有 48 格（服务端确定性生成 ⇒ SSR 天然带盘面，LL-01 靠这条）。
        // 计时器与存储一律等到 firstRender（只有交互实例才有 JSRuntime）。
        // H-018：期号可以来自日历页的 ?issue=（跨页进入才会走到这里，页内换期见 PickIssue 的注释）。
        issue = PickIssue(Nav.Uri, LianliankanCore.IssueFor(DateTimeOffset.UtcNow));
        game = LianliankanCore.NewDaily(issue);
    }

    /// <summary>
    /// 从 URL 取 <c>?issue=</c>；不合法（缺参 / 非数字 / 越界）一律<b>静默回落当日</b> —— 不弹提示、不改路由。
    /// </summary>
    /// <remarks>
    /// <para><b>用 <c>Nav.Uri</c> 手工查表，不用 <c>Nav.ToAbsoluteUri</c> 的 <c>Query</c></b>：站内 SPA 导航时
    /// 后者可能滞后一拍。手工解析的代价是十来行，收益是"读到的就是地址栏里那一串"。</para>
    /// <para>上界是<b>今天</b>：未来关一律回落。下界是 <see cref="LianliankanCore.MinIssue"/>。
    /// 服务端提交那道闸（<c>SubmitAsync</c>）会再判一次 —— 这里是"给人少走一步"，不是安全边界。</para>
    /// </remarks>
    private static int PickIssue(string uri, int todayIssue)
    {
        var q = uri.IndexOf('?', StringComparison.Ordinal);
        if (q < 0) return todayIssue;

        var issue = todayIssue;
        foreach (var kv in uri[(q + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = kv.IndexOf('=');
            if (eq <= 0) continue;
            if (!kv.AsSpan(0, eq).Equals("issue", StringComparison.OrdinalIgnoreCase)) continue;

            if (int.TryParse(Uri.UnescapeDataString(kv[(eq + 1)..]), out var v)
                && v >= LianliankanCore.MinIssue && v <= todayIssue)
            {
                issue = v;
            }
        }
        return issue;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;                       // 规避 ServerPrerendered 的预渲染实例

        // ① 本关最快（按期号取，可能是日历里选中的历史关）
        if (!isBestReading)
        {
            isBestReading = true;
            try
            {
                var raw = await JS.InvokeAsync<string?>("localStorage.getItem", LlkKeys.Best);
                best = LianliankanCore.TryParseBest(raw, issue);
            }
            catch (JSException) { }                     // 隐私模式/存储被禁：保持 null，显示「—」，游戏零降级
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }

            // 昵称预填（H-018）：与纪录分开读 —— 纪录是"成绩"，昵称是"上次填过的名字"，两者生命周期不同
            try
            {
                var nick = await JS.InvokeAsync<string?>("localStorage.getItem", LlkKeys.Nickname);
                if (!string.IsNullOrWhiteSpace(nick)) nameInput = nick;
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }

            isBestLoaded = true;
            StateHasChanged();
        }

        // ①.5 减少动效偏好（D-31）。**必须排在 ② 之前** —— 恢复死局档的重排就发生在 ② 里，
        //      读到时长得为 0 才能正确短路两阶段。visibilityModule 在这里先加载好，
        //      ④ 的 ??= 于是变成空操作（同一 URL 的 import 本来也只请求一次）。
        if (!motionPrefRead)
        {
            motionPrefRead = true;                      // 先置位：读失败也不重试、不阻塞恢复
            try
            {
                visibilityModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/llkvisibility.js");
                if (await visibilityModule.InvokeAsync<bool>("prefersReducedMotion"))
                {
                    shuffleOutMs = 0;
                    shuffleInMs = 0;
                }
            }
            catch (JSException) { }                     // 降级：保留 220/250（有动画，但流程正常）
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }

        // ② 恢复对局（结构闸 + 期号闸；死局交给重排，不丢档）
        if (!isSessionReady)
        {
            isSessionReady = true;                      // 先开闸：即使下面全失败，也不能永久不写
            try
            {
                var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", LlkKeys.Session);
                if (json is not null)
                {
                    var snap = JsonSerializer.Deserialize<LianliankanSnapshot>(json);
                    var restored = LianliankanCore.TryFrom(snap, issue);
                    if (restored is null)
                    {
                        await JS.InvokeVoidAsync("sessionStorage.removeItem", LlkKeys.Session);
                    }
                    else
                    {
                        game = restored;
                        selectedIdx = -1;

                        // D-42：**起表时刻从快照来，不是"现在"**。老档（无 startedAtMs）由 Core 折算。
                        //   随后 elapsedSec 立刻按时间差算一遍 —— 于是"上一次存档之后"的时间
                        //   （切页 / 刷新 / 锁屏期间的真实流逝）一次补齐，不再依赖 tick 是否在跑。
                        startedAt = LianliankanCore.StartedAtOf(snap!, DateTimeOffset.UtcNow);
                        elapsedSec = ElapsedSeconds();

                        // H-020：恢复出来的档可能已经用满限时 ⇒ 直接进超时态（不再"接着玩"）。
                        //   这条不能省：tick 要等一拍才判，那一拍里玩家是能点动的。
                        if (LianliankanCore.IsOverLimit(elapsedSec))
                        {
                            await OnTimeoutAsync();
                        }
                        else
                        {
                            showResumeTip = true;           // 超时局不说"已恢复，接着计时"（那是假话）
                            StartClock();                    // D-42：恢复后时间接着走，不等首点

                            // 死局档不丢弃：恢复后第一帧就重排（v2.0 §0 #7 —— 丢弃等于把玩家打回第 1 关）
                            // 这里用 await：它在 try 内，finally 的 isRestoring = false 自然排在动画之后
                            // ⇒ 恢复场景 isRestoring 与 isReshuffling 双闸挡输入，不必额外处理。
                            if (!game.HasAnyPair())
                            {
                                await ReshuffleWithTransitionAsync();
                            }
                        }

                        StateHasChanged();
                    }
                }
            }
            catch (JSException) { }
            catch (JsonException) { }                   // 半截 JSON
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            finally
            {
                isRestoring = false;                    // 任何失败路径都不能把页面永久卡在恢复态
                if (!disposed) StateHasChanged();
            }
        }

        // ③ 首访玩法遮罩（H-015）。放在恢复之后：恢复失败也不该挡住"先看规则"。
        if (!isRulesChecked)
        {
            isRulesChecked = true;
            try
            {
                var seen = await JS.InvokeAsync<string?>("localStorage.getItem", LlkKeys.RulesSeen);
                showRules = string.IsNullOrEmpty(seen);
            }
            catch (JSException) { showRules = true; }   // 隐私模式：宁可每次弹一次，也别让人无从下手
            catch (JSDisconnectedException) { showRules = true; }
            catch (ObjectDisposedException) { }

            if (!disposed) StateHasChanged();
        }

        // ④ 切后台暂停（服务端计时器不会因为标签页隐藏而停，切 5 分钟回来"用时"直接 +300 秒）
        try
        {
            visibilityModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/llkvisibility.js");
            selfRef ??= DotNetObjectReference.Create(this);
            await visibilityModule.InvokeVoidAsync("register", selfRef);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        // ⑤ sprite 可用性探测（H-016 / D-33 / D-34）。放最后：它不阻塞恢复对局、不阻塞遮罩判定，
        //    也不参与排版（降级只切 class）。
        //    返回值只用于排障：**降级全过程在 JS 里完成**（class + data-llk-sprite），不回写组件状态
        //    ⇒ 不需要 StateHasChanged，也没有"探测结果与渲染状态不一致"这第二份真相。
        //    为什么不用 DotNetObjectReference 做"迟到恢复"：④ 那条链是"可见性变化 → 改组件状态"、必须回 C#；
        //    而降级/恢复只改 CSS，回 C# 反而多一条引用生命周期要维护（能力边界不同，别照抄）。
        //    为什么 JS 侧先查 Resource Timing 条目再探针（D-34）：真机上出现过"CSS 画得出来、
        //    `new Image()` 却 onerror"（无图模式只拦 JS 侧），探针的瞬时失败会摘掉明明可用的 sprite。
        //    页面自己的条目是直接事实、探针只是代理指标 —— 直接事实优先，顺序不能颠倒。
        //    排障看 `data-llk-sprite-src`：css（条目闸短路，图本来就好）/ probe（探针给了结论）/ fallback（真降级）。
        try
        {
            visibilityModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/llkvisibility.js");
            if (!disposed)
            {
                await visibilityModule.InvokeAsync<string>(
                    "applySpriteFallback", ".llk-board", "/Images/llk/faces.png", SpriteProbeMs);
            }
        }
        catch (JSException) { }                     // 探测本身失败就不降级：退化为现状（格子仍是米纸底）
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    // ───────────────────────── 重排过渡（D-31） ─────────────────────────

    /// <summary>
    /// 重排 + 两阶段淡出淡入。
    /// <para><b>为什么必须分两次渲染</b>：CSS 没法在 face 变化的那一帧"先淡出旧脸"——旧脸在 DOM 里
    /// 已经被新脸替换，没有东西可淡出。所以先渲染【旧脸 + <c>is-shuffle-out</c>】、等 220ms，
    /// 再改状态渲染【新脸 + <c>is-shuffle-in</c>】。</para>
    /// <para>唯一要守的纪律：<b>两次 <c>StateHasChanged</c> 之间必须有真 await</b>。
    /// 写成同一个同步块（或 <c>Task.Delay(0)</c> 走同步完成快路径）会被 Blazor 合并成一次渲染，
    /// 阶段 1 根本不进 DOM。下面的分支写法就是为这条服务 —— reduced-motion 时反而故意让它合并。</para>
    /// <para>算法、触发条件、判定精度全部零改动：这里只是把 <c>game.Reshuffle()</c> 包进两段延时。</para>
    /// </summary>
    private async Task ReshuffleWithTransitionAsync()
    {
        isReshuffling = true;
        showReshuffleTip = true;                    // 与动画同帧出现

        if (shuffleOutMs > 0)                       // reduced-motion 时短路，不进入阶段 1
        {
            reshufflePhase = 1;
            RenderSafe();
            await Task.Delay(shuffleOutMs);
            if (disposed) return;
        }

        var before = game.Cells.ToArray();          // H-017：配对的唯一依据（同脸方块视觉全同）
        game.Reshuffle();

        if (shuffleInMs > 0)
        {
            reshufflePhase = 2;
            RenderSafe();                           // 换脸与换 class 落在同一次 render batch
            await PlayShuffleAsync(LianliankanCore.PairShuffleMoves(before, game.Cells));
            await Task.Delay(Math.Max(shuffleInMs, ShuffleFlipMs));
            if (disposed) return;
        }

        reshufflePhase = 0;
        isReshuffling = false;
        await SaveSessionAsync();                   // 存重排后的可解盘（死局盘已被主流程先存过一次）
        RenderSafe();
    }

    /// <summary>
    /// 阶段 2 的 FLIP 滑入（H-017）。失败一律吞掉：动画缺席不影响对局（与 <see cref="DrawLineAsync"/> 同口径）。
    /// </summary>
    private async Task PlayShuffleAsync(IReadOnlyList<(int From, int To)> moves)
    {
        if (moves.Count == 0) return;               // Reshuffle 返回 false / 盘面没动 ⇒ 不调 JS

        try
        {
            shuffleModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/llkshuffle.js");
            // 传 int[][] 而不是元组：同一页 DrawLineAsync 已踩过（ValueTuple 的 Item1/Item2 是**字段**，
            // System.Text.Json 默认只序列化属性 ⇒ 元组过来会变成 [{}]，JS 侧一次都不会动、也不报错）
            var payload = moves.Select(m => new[] { m.From, m.To }).ToArray();
            await shuffleModule.InvokeVoidAsync("playShuffle", ".llk-board", payload);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>
    /// <c>StateHasChanged</c> 的兜底版。动画把"渲染窗口"从 0 拉到 600ms（H-017），
    /// 期间 circuit 断开的概率比同步路径高，直接调会抛 <see cref="InvalidOperationException"/>
    /// （渲染队列已关；同 <c>RunClockAsync</c> 收的那条）。
    /// </summary>
    private void RenderSafe()
    {
        if (disposed) return;

        try
        {
            StateHasChanged();
        }
        catch (ObjectDisposedException) { }             // 须排在前面：它是 InvalidOperationException 的子类
        catch (InvalidOperationException) { }
    }

    // ───────────────────────── 交互 ─────────────────────────

    /// <summary>消除一格，但先把脸留在 lastFace —— 渲染段据此保持 sprite 原位（D-32）。
    /// 封成一处是为了让「读原值 → 换算行列 → Remove」只写一次：以后若多出第三个消除入口
    /// （比如"提示直接消"），直接调它就不会漏记。视图态不进 Core（进 Core 会让单测被迫关心 UI）。</summary>
    private void RemoveKeepingFace(int i)
    {
        lastFace[i] = game.Cells[i];
        game.Remove(i / LianliankanCore.Cols, i % LianliankanCore.Cols);
    }

    private async Task OnCellClickedAsync(int idx)
    {
        // isReshuffling：动画 470ms 内的输入一律"吞"掉，不排队 —— 死局瞬间玩家没有有效操作可丢，
        // 排队要存点击参数 + 去重 + 动画后重放，复杂度不值。代价：窗口内第一击无反馈（与 isRestoring 同手感）。
        // reduced-motion 时这条自动失效（isReshuffling 从 true 到 false 之间没有 await 让出，从未被渲染）。
        // isTimedOut（H-020）：锁盘。**必须在这里**，不能只靠遮罩挡点击 —— 遮罩只盖 .llk-board-wrap，
        //   而棋盘恰好在 wrap 里（这条与提示按钮的禁用口径同源）。
        if (isRestoring || isReshuffling || showRules || game.IsCleared || isTimedOut) return;

        var face = game.Cells[idx];
        if (face == 0) return;                          // 空格：不参与选中

        showResumeTip = false;

        if (selectedIdx < 0)
        {
            // 玩家已经开始操作，两条通知的使命都结束了。只清 showResumeTip 的话，
            // 反馈的 1.6s 过后被"盖住"的重排提示会再冒出来，文字闪一下（D-30）。
            showReshuffleTip = false;
            selectedIdx = idx;
            ResumeClock();                              // startedAt ??= now：首点起表

            // ★ 选中分支**前置判**超时（H-020）：否则玩家可以靠不断点空格/换选把超时无限推后
            //   （每点一下都会重新渲染，而 tick 只在 InvokeAsync 里判）。消除分支不能前置 —— 见下。
            if (LianliankanCore.IsOverLimit(ElapsedSeconds()))
            {
                _ = OnTimeoutAsync();
                return;
            }
            if (!disposed) StateHasChanged();
            return;
        }

        if (selectedIdx == idx)                         // 再点一次 = 取消选中
        {
            selectedIdx = -1;
            if (!disposed) StateHasChanged();
            return;
        }

        var first = selectedIdx;
        var r1 = first / LianliankanCore.Cols;
        var c1 = first % LianliankanCore.Cols;
        var r2 = idx / LianliankanCore.Cols;
        var c2 = idx % LianliankanCore.Cols;
        var firstFace = game.Cells[first];

        // ① 异脸：**不画线**。线的语义是"该连"，和「图案不同」正好打架；
        //    这一层的教学重点是"认图案"，不是"路怎么走"（《39》§2.1）。
        if (firstFace != face)
        {
            selectedIdx = idx;
            _ = ShowFeedbackAsync(LlkCopy.DifferentFaces(firstFace, face), first, idx);
            return;
        }

        // 一次搜索拿全部信息：int.MaxValue 返回的就是最省拐（U9 钉住"最省"本身）。
        // ⚠ 这句话在 D-37 之前是假的：0-1 BFS 首次命中即返回，同层内可能多报 1 拐，
        //   而 U1 钉的只是「有界调用的存在性」——它证明不了"最省"。
        var path = game.TryFindPath(r1, c1, r2, c2, int.MaxValue);

        if (path is not null && path.Turns <= LianliankanCore.TurnLimit)
        {
            // ② 可连：★ 必须在 Remove 之前画 —— is-gone 的 scale(.6) 会让
            //    getBoundingClientRect 返回缩小后的矩形，先删再画会把线连到格子内侧 40%。
            await DrawLineAsync(path, "success");
            if (disposed) return;

            RemoveKeepingFace(first);
            RemoveKeepingFace(idx);
            selectedIdx = -1;
            showReshuffleTip = false;
            ClearFeedback();                            // 消成功就把失败提示与提示高亮一起收掉
            ResumeClock();
            // 存档 / 结算前把读数收口到"真实用时"：tick 一秒一拍，此刻的 elapsedSec 可能是上一拍的旧值，
            // 直接拿它存档会让"最后一次存档之后"的那段时间仍然是黑的（D-42 的另一半）。
            elapsedSec = Math.Max(elapsedSec, ElapsedSeconds());

            if (game.IsCleared)
            {
                StopClock();
                // 0 秒会被永久锁死（同《35》D-27 口径）：首点起表 + 1 秒一拍，理论上仍可能同秒清空
                if (elapsedSec < 1) elapsedSec = 1;

                // ★ 通关优先（H-020）：最后一对在 299.x 秒点下时 tick 可能已经越过 300。
                //   这里**不判超时** —— "限时内完成"是产品承诺，不该被 tick 的 1 秒粒度吃掉。
                //   代价是理论上可以"300 秒后靠一击通关"，但那需要玩家在超时遮罩弹出前的一瞬点中，
                //   而遮罩与 StopClock 都在同一帧里落地 ⇒ 窗口只有一次 SignalR 往返。
                var oldBest = best;                     // ★ 必须在 TryUpdateBest 之前取：之后 best 已是新值
                var next = LianliankanCore.TryUpdateBest(best, elapsedSec);
                if (next is not null) best = next;
                clearNote = LlkCopy.ClearNote(oldBest, elapsedSec);   // H-021 三分支
                await PersistBestAsync();               // 落盘点 ①：胜利瞬间（与遮罩同帧）
                await RemoveSessionAsync();             // 已通关的盘没有可恢复的语义
            }
            else
            {
                // ★ 超时的另一半（H-020）：非通关才判。放在"消除之后"而不是点击开头，
                //   正是为了让限时内点下的最后一对能进上面的胜利路径（通关优先）。
                if (LianliankanCore.IsOverLimit(elapsedSec))
                {
                    _ = OnTimeoutAsync();
                    if (!disposed) StateHasChanged();
                    return;
                }

                if (!game.HasAnyPair())                 // 死局：自动重排，别让玩家卡死
                {
                    // fire-and-forget：主流程不等这 470ms（否则"消除 → 存档 → 渲染"整条链一起被推迟）。
                    // 下面那行 SaveSessionAsync 存的是【死局盘】，动画结束时再存一次【重排盘】覆盖；
                    // 中间态即使被恢复流程读到也有"恢复即重排"兜底（《40》v2.0 §3.3）。
                    _ = ReshuffleWithTransitionAsync();
                }
                await SaveSessionAsync();               // 落盘点 ②：每次消除
            }

            if (!disposed) StateHasChanged();
            return;
        }

        if (path is not null)
        {
            // ③ 同脸、有路但 >2 拐：虚线 + 拐点呼吸 + 文案，**不抖**。
            //    画面已经画出"路是有的、只是拐太多"，再抖就是两个信号打架。
            _ = DrawLineAsync(path, "hint");
            selectedIdx = idx;
            _ = ShowFeedbackAsync(LlkCopy.NotConnectable, first, idx, shake: false);
            return;
        }

        // ④ 彻底没路：先清掉还在飘的旧虚线，再抖 + 独立文案（与 ③ 的"拐数不够"是两件事）
        _ = ClearLinesAsync();
        selectedIdx = idx;
        _ = ShowFeedbackAsync(LlkCopy.NoRoute, first, idx);
    }

    /// <summary>重开的唯一用户入口（遮罩按钮）。</summary>
    private async Task OnRestartClicked()
    {
        if (isRestoring) return;

        StopClock();
        // H-018：**不重算期号**。从日历点进 20261105 再点「再来一局」，留在 20261105 ——
        // 重算"今天"会把用户悄悄换到另一关（而标题还写着旧期号的那一刻也没了）。
        game = LianliankanCore.NewDaily(issue);
        Array.Clear(lastFace);                          // 字段 = 本局事实（D-32）：不清也不出错，但"再来一局"该是干净局
        elapsedSec = 0;
        selectedIdx = -1;
        // D-42：新一局回到"还没起表"（不是"暂停"）—— startedAt 为 null 才是页面打开时的初态。
        startedAt = null;
        isTimedOut = false;                             // H-020：超时后「再来一局」要能重新开局
        clearNote = null;                               // H-021：上一局的结算行不能留到下一局
        showResumeTip = false;
        showReshuffleTip = false;
        submitted = false;                              // 新一局可以再提交一次
        isSubmitting = false;
        submitError = null;                             // D-40：上一局的失败/不够快提示不能留到下一局
        submitNote = null;
        // 重排动画的理论窗口不会横跨重开（重开只在 IsCleared 时，重排只在未清盘时）——
        // 但重置成本为零，且能防"动画中途被 fire-and-forget 启动、随后遮罩出现"这类将来才有的组合。
        reshufflePhase = 0;
        isReshuffling = false;
        ClearFeedback();

        best = await ReadBestAsync();                   // 同一期号重开：纪录不变；nameInput 保留（同一个人再玩一次）
        await RemoveSessionAsync();
        if (!disposed) StateHasChanged();
    }

    /// <summary>
    /// 把本局成绩提交到服务端榜（H-018）。
    /// <para><b>三态</b>（D-40 / C-98）：落盘成功 ⇒「已记入榜单」；不够快 ⇒ 灰字提示、<b>按钮仍在</b>（可换名字再点）；
    /// 落盘失败 ⇒ 红字「提交失败：纪录只保存在本机」。<b>"失败一律静默"正是本轮要修的东西</b>：
    /// 偶发 IO 故障静默是对的，但永久性权限故障被它抹成"点了没反应"，等于把一次运维遗漏放大成看起来像 bug 的黑洞。</para>
    /// <para><b>断连类仍然静默</b>（<c>JSDisconnectedException</c> / <c>ObjectDisposedException</c>）：circuit 已经死了，
    /// 改 UI 没有意义，连 <c>StateHasChanged</c> 都可能再抛一次。</para>
    /// <para>失败文案只说"没存上"，<b>不把异常类型或路径写给访客</b> —— 分类与路径由服务端日志和 <c>/llkhealth</c> 说。</para>
    /// <para><see cref="submitted"/> <b>只在成功落盘后</b>置位：没进榜（不够快/失败）时按钮还在，可以再点。</para>
    /// </summary>
    private async Task OnSubmitNameClicked()
    {
        if (isSubmitting || submitted) return;

        isSubmitting = true;
        submitError = null;                             // 重试要先把上一轮的提示清掉，否则"红字还在但这次成功了"
        submitNote = null;
        try
        {
            var rec = await Board.SubmitAsync(issue, elapsedSec, nameInput);
            if (rec is null)
            {
                // 闸拒 / 不够快。闸在 UI 上不可达（页面已拦未来关与越界秒数），所以这里实际只覆盖"不够快"
                submitNote = LlkCopy.NotFaster;
                return;
            }

            submitted = true;
            try
            {
                // 记住名字：下次进来预填，省得每次重敲。存的是**归一后**的值（与榜上一致）
                await JS.InvokeVoidAsync("localStorage.setItem", LlkKeys.Nickname, rec.Name);
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
        catch (JSDisconnectedException) { }             // circuit 已死：改 UI 无意义
        catch (ObjectDisposedException) { }
        catch (Exception)
        {
            // 权限 / 路径 / IO / 未知一律同一句对外文案：访客不需要（也不该看到）内部路径与异常名
            submitError = LlkCopy.SubmitFailedLocal;
        }
        finally
        {
            isSubmitting = false;
            if (!disposed) StateHasChanged();
        }
    }

    // ───────────────────────── 计时（时间差 + 节拍器 + 互斥 + 双检） ─────────────────────────

    /// <summary>
    /// 当前用时（秒）。<b>是时间差，不是计数器</b>（D-42）—— tick 停了、漏拍了、组件被 dispose 了，
    /// 只要 <see cref="startedAt"/> 还在，这个数就永远是对的。
    /// </summary>
    /// <remarks>
    /// <c>Math.Max(0, …)</c> 是必须的：系统时间被调回（或用户在"跨时区"的机器上改了时钟）时
    /// <c>UtcNow - startedAt</c> 是负数，状态行会显示「用时：-3 秒」。
    /// </remarks>
    private int ElapsedSeconds()
    {
        if (startedAt is not { } t) return 0;
        return Math.Max(0, (int)(DateTimeOffset.UtcNow - t).TotalSeconds);
    }

    /// <summary>
    /// 起表 / 续走。首次点击与之后每一次点击走同一条（H-020 的点击入口也要调它）。
    /// <para><b><c>??=</c> 是关键</b>：只补"从没起过"，绝不重置 —— 恢复出来的档带真起表时刻，
    /// 点击不能把它刷新成"现在"（那等于每次点击白送一分钟）。</para>
    /// </summary>
    private void ResumeClock()
    {
        startedAt ??= DateTimeOffset.UtcNow;
        StartClock();
    }

    private void StartClock()
    {
        lock (timerLock)
        {
            if (disposed || clockCts is not null) return;
            clockCts = new CancellationTokenSource();
            _ = RunClockAsync(clockCts.Token);
        }
    }

    private void StopClock()
    {
        lock (timerLock)
        {
            if (clockCts is null) return;
            try
            {
                clockCts.Cancel();
            }
            catch (ObjectDisposedException) { }
            clockCts.Dispose();
            clockCts = null;
        }
    }

    private async Task RunClockAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (disposed || isTimedOut || startedAt is null || game.IsCleared) continue;

                await InvokeAsync(() =>
                {
                    if (disposed || isTimedOut || game.IsCleared) return;

                    // ★ 重算而不是 ++（D-42 的关键一行）：tick 只是"刷新显示"的节拍器，
                    //   漏拍（线程池排队 / 浏览器后台节流 / 断连重连）会在下一拍自动补齐，
                    //   而不是永久少一秒。写成 elapsedSec++ 的话，任何一次"停表"都会变成"丢时间"。
                    var sec = ElapsedSeconds();
                    if (LianliankanCore.IsOverLimit(sec))
                    {
                        _ = OnTimeoutAsync();           // 超时判定下沉到 Core，文案与判定同源
                        return;
                    }
                    if (sec != elapsedSec)
                    {
                        elapsedSec = sec;
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) { }          // 停表 / Dispose：正常路径
        catch (ObjectDisposedException) { }             // 组件已释放
        catch (InvalidOperationException) { }           // circuit 已断，InvokeAsync 无法排队
    }

    /// <summary>
    /// 超时收尾（H-020）。<b>幂等</b>：tick 与点击入口都可能先到，两边都会调。
    /// </summary>
    /// <remarks>
    /// <para>读数<b>冻结在 300</b>，不显示 301 —— 遮罩上"用满 300 秒"与状态行必须是同一个数，
    /// 否则玩家会看到"用满 300 秒"下面写着 302 秒。</para>
    /// <para><b>删档是必须的</b>：超时局若还能恢复，下次进页面立刻又超时，等于永久锁死这一关
    /// （LL-46 守的就是这条）。</para>
    /// <para>不写 best、不进榜：<c>TryUpdateBest</c> 只在胜利路径。</para>
    /// </remarks>
    private async Task OnTimeoutAsync()
    {
        if (isTimedOut || disposed) return;

        // ★ 通关优先（H-020 竞态的另一半）：tick 的 `_ = OnTimeoutAsync()` 是 fire-and-forget，
        //   它可能在"最后一对已经消掉、胜利遮罩正在渲染"之后才落地。那时若照样置 isTimedOut，
        //   上面两个 `@if`（IsCleared / isTimedOut）会**同时成立**、叠出两个遮罩。
        //   放在这里而不是模板里加 `&& !isTimedOut`：治因比治果稳 —— 状态本身就不该出现。
        if (game.IsCleared) return;

        isTimedOut = true;
        elapsedSec = LianliankanCore.TimeLimitSec;
        StopClock();
        await RemoveSessionAsync();
        if (!disposed) StateHasChanged();
    }

    /// <summary>返回关卡选择（H-021）。胜利与超时两个遮罩共用。</summary>
    private void OnBackToCalendarClicked() => Nav.NavigateTo("/llkcalendar");

    // ───────────────────────── 本关最快（秒，越小越好） ─────────────────────────

    private async Task<int?> ReadBestAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", LlkKeys.Best);
            return LianliankanCore.TryParseBest(raw, issue);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        return null;
    }

    private async Task PersistBestAsync()
    {
        if (best is null) return;

        try
        {
            // 载荷由 Core 序列化（键名/字段名只有一处），页面不手拼 JSON
            await JS.InvokeVoidAsync("localStorage.setItem", LlkKeys.Best, LianliankanCore.BestJson(issue, best.Value));
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    // ───────────────────────── 会话快照 ─────────────────────────

    private async Task SaveSessionAsync()
    {
        if (!isSessionReady) return;                    // 预渲染 / 恢复前：绝不写

        try
        {
            // D-42：起表时刻一起落盘 —— 这是"时间不再依赖 tick"的落地点。
            var json = JsonSerializer.Serialize(game.ToSnapshot(elapsedSec, startedAt));
            await JS.InvokeVoidAsync("sessionStorage.setItem", LlkKeys.Session, json);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task RemoveSessionAsync()
    {
        if (!isSessionReady) return;

        try
        {
            await JS.InvokeVoidAsync("sessionStorage.removeItem", LlkKeys.Session);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        StopClock();

        // 切页/关页前把"已过秒数"固化一次（MS-08 的教训：秒数只在消除时写会丢掉最后一次操作之后的用时）。
        // 站内 NavLink 切页时 interop 仍可用；关标签页会抛 JSDisconnectedException，已在内部吞掉。
        if (!game.IsCleared) await SaveSessionAsync();

        try
        {
            if (visibilityModule is not null) await visibilityModule.InvokeVoidAsync("unregister");
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        try
        {
            if (visibilityModule is not null) await visibilityModule.DisposeAsync();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        try
        {
            if (lineModule is not null) await lineModule.DisposeAsync();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        try
        {
            if (shuffleModule is not null) await shuffleModule.DisposeAsync();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }

        selfRef?.Dispose();
    }
}
