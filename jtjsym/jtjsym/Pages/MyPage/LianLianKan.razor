        font-size: .85rem;
        line-height: 18px;
        color: #455a64;
    }

    .llk-resume-tip,
    .llk-reshuffle-tip,
    .llk-click-tip {
        margin: 0;
        font-size: .85rem;
        color: #455a64;
    }

    /* 紧凑档（《36》v2.1 §3.2）：320×568 靠这三条才不溢出 ——
       h1 收到单行（省 38px）、状态行收到一行 18px、棋盘 gap 4（省 14px）。
       逐项加法：navbar 56 + pad 17.6 + 标题 22 + 状态 18 + 棋盘 364 + 页脚 30 ≈ 508 ≤ 568。 */
    @@media (max-width: 400px), (max-height: 620px) {
        .llk-title {
            font-size: 18px;
            line-height: 22px;
            margin: 0 0 4px;
        }

        .llk-status {
            gap: 10px;
            font-size: 13px;
            line-height: 18px;
        }

        .llk-board {
            gap: 4px;
        }
    }
</style>

@code {
    /// <summary>今日期号。预渲染实例与交互实例都按"此刻"算，同一天必一致（跨日那一秒的极端情况由期号闸兜住）。</summary>
    private int issue = LianliankanCore.IssueFor(DateTimeOffset.UtcNow);

    private LianliankanCore game = LianliankanCore.NewDaily(LianliankanCore.IssueFor(DateTimeOffset.UtcNow));

    /// <summary>每格最后一张脸（0 = 从未有过）。消除格用它保持 sprite 原位（D-32）。
    /// 连连看消除格永不复活（Core 里 Remove 是唯一置 0 处）⇒ 每格最多写一次，无需失效逻辑。
    /// 恢复局 / 预渲染时全 0，渲染走兜底 (0,0) —— 与修复前完全一致（那些格带 is-gone 恒不可见）。</summary>
    private readonly int[] lastFace = new int[LianliankanCore.CellCount];

    private int elapsedSec;
    private int? best;

    /// <summary>名字输入框的当前值（H-018）。首帧从 <c>localStorage['jtjsym.llk.nickname']</c> 预填。</summary>
    private string? nameInput;

    /// <summary>本次已成功提交（防重复点击）。<b>只在成功后才置位</b> —— 失败可以再点一次。</summary>
    private bool submitted;

    /// <summary>提交往返中（按钮短暂禁用，防双击产生两次请求）。</summary>
    private bool isSubmitting;

    /// <summary>
    /// 提交失败文案（D-40 / C-98）。<c>null</c> = 无错。<b>不复用 <see cref="submitted"/></b>：
    /// 那个是"已进榜"，这个是"没存上"，两者语义相反，挤在一个字段上迟早把重试路径写死。
    /// </summary>
    private string? submitError;

    /// <summary>不够快（<c>SubmitAsync</c> 返回 <c>null</c>）时的灰字提示；按钮仍然在，可换名字重试。</summary>
    private string? submitNote;

