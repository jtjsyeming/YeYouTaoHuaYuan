@page "/loveTime"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>爱情计时器</PageTitle>

<h1>爱情计时器</h1>

<div class="timer timer-display">我们相识已经过去了：@elapsedTimes["meet"].ElapsedTime</div>
@* 副行只带 timer-calendar：绝不能加 timer 类（LT-01 断言 div.timer 恰为 3 个） *@
<div class="timer-calendar">@elapsedTimes["meet"].CalendarText</div>

<div class="timer timer-display">我们相爱已经过去了：@elapsedTimes["love"].ElapsedTime</div>
<div class="timer-calendar">@elapsedTimes["love"].CalendarText</div>

<div class="timer timer-display">我们步入婚姻已经过去了：@elapsedTimes["married"].ElapsedTime</div>
<div class="timer-calendar">@elapsedTimes["married"].CalendarText</div>

<h2>输入你的时间节点和想要计算的类型</h2>

<div class="date-bar">
    <!-- 年份 -->
    <FluentSelect TOption="string"
                  Label="年份："
                  @bind-Value="selectedYear"
                  @bind-Value:after="OnYearMonthChanged"
                  class="custom-select"
                  Width="120px">
        @foreach (var y in years)
        {
            <FluentOption Value="@y">@y</FluentOption>
        }
    </FluentSelect>

    <!-- 月份 -->
    <FluentSelect TOption="string"
                  Label="月份："
                  @bind-Value="selectedMonth"
                  @bind-Value:after="OnYearMonthChanged"
                  class="custom-select"
                  Width="100px">
        @foreach (var m in months)
        {
            <FluentOption Value="@m">@m</FluentOption>
        }
    </FluentSelect>

    <!-- 日期：加 @key，年/月变化时强制重建，避免 FAST Web Component 选项列表不刷新 -->
    <FluentSelect @key="@($"{selectedYear}-{selectedMonth}")"
                  TOption="string"
                  Label="日期："
                  @bind-Value="selectedDay"
                  @bind-Value:after="OnDayChanged"
                  class="custom-select"
                  Width="100px">
        @foreach (var d in days)
        {
            <FluentOption Value="@d">@d</FluentOption>
        }
    </FluentSelect>
</div>

<FluentStack Horizontal="true"
             HorizontalGap="20"
             Wrap="true"
             Style="justify-content:center; padding: 10px;">
    <FluentButton class="timer" OnClick="@(() => ApplyCustomDate("meet"))">计算相识时间</FluentButton>
    <FluentButton class="timer" OnClick="@(() => ApplyCustomDate("love"))">计算恋爱时间</FluentButton>
    <FluentButton class="timer" OnClick="@(() => ApplyCustomDate("married"))">计算结婚时间</FluentButton>
</FluentStack>

@* P1：自选日期会覆盖顶部对应那一行的锚点，提供一键还原内置纪念日 *@
<div class="love-reset-bar">
    <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => ResetAnchor("meet"))">恢复相识默认</FluentButton>
    <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => ResetAnchor("love"))">恢复恋爱默认</FluentButton>
    <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => ResetAnchor("married"))">恢复结婚默认</FluentButton>
</div>

@if (!string.IsNullOrEmpty(validationMessage))
{
    <div class="love-validation-tip">@validationMessage</div>
}

@code {
    private sealed class ElapsedTimeInfo
    {
        public string ElapsedTime { get; set; } = string.Empty;    // 主行：天/时/分/秒
        public string CalendarText { get; set; } = string.Empty;   // 副行：日历口径的年月天
    }

    private readonly Dictionary<string, ElapsedTimeInfo> elapsedTimes = new()
    {
        { "meet", new ElapsedTimeInfo() },
        { "love", new ElapsedTimeInfo() },
        { "married", new ElapsedTimeInfo() }
    };

    /// <summary>内置纪念日，常量语义，永不被改写。</summary>
    private static readonly Dictionary<string, DateTime> timePoints = new()
    {
        { "meet", new DateTime(2018, 4, 22) },
        { "love", new DateTime(2022, 2, 25) },
        { "married", new DateTime(2023, 8, 8) }
    };

    /// <summary>各类型当前生效的锚点：默认 = 内置纪念日，用户自选后被替换。刷新 Tick 只读它。</summary>
    private readonly Dictionary<string, DateTime> anchorDates = new(timePoints);

    private List<string> years = new();     // P-014：由 EnsureYearsFresh 构建（跨年自愈），不再一次性生成
    private int yearsBuiltFor;              // 0 → 首次 RefreshAll 必建一次，避免"字段初始化跨年对不齐"
    private readonly List<string> months =
        Enumerable.Range(1, 12).Select(m => m.ToString()).ToList();

    private List<string> days = new();

    private string selectedYear = "1950";
    private string selectedMonth = "1";
    private string selectedDay = "1";

    private string? validationMessage;

    private CancellationTokenSource? tickerCts;
    private bool isDisposed;

    // ---------- D-08：后台标签暂停秒刷 ----------
    // isHidden 由 JS 回调线程写、ticker 循环（线程池）读，故必须 volatile。
    private volatile bool isHidden;
    private IJSObjectReference? visModule;
    private DotNetObjectReference<LoveTime>? visRef;
    private int visHandlerId;

    protected override void OnInitialized()
    {
        RebuildDays();
        RefreshAll();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 仅交互实例会走到 firstRender=true，规避 ServerPrerendered 的预渲染实例
        if (!firstRender || visModule is not null) return;

        // ① 先启 ticker：相位从"页面开始交互的那一瞬"起算，LT-31 的相位对齐依赖它。
        //    顺序不可颠倒 —— 若先 await import 再启，φ 会跟着 import 的往返时间漂移。
        StartTicker();

        // ② 再注册可见性监听（失败不影响计时：ticker 已在跑，后台暂停退化为不生效）
        visRef = DotNetObjectReference.Create(this);

        try
        {
            visModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/lovetimer.js");
        }
        catch (JSDisconnectedException) { visRef.Dispose(); visRef = null; return; }
        catch (ObjectDisposedException) { visRef.Dispose(); visRef = null; return; }
        catch (JSException) { visRef.Dispose(); visRef = null; return; }

        // 复检：import 期间组件可能已被销毁（DisposeAsync 当时 visModule 还是 null，什么都没卸）
        if (isDisposed)
        {
            try { await visModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (JSException) { }
            visModule = null;
            visRef.Dispose();
            visRef = null;
            return;
        }

        try
        {
            visHandlerId = await visModule.InvokeAsync<int>("register", visRef);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
    }

    // ---------- 秒级刷新 ----------

    private void StartTicker()
    {
        if (isDisposed || tickerCts is not null) return;   // 防重复启动

        tickerCts = new CancellationTokenSource();
        _ = RunTickerAsync(tickerCts.Token);
    }

    private async Task RunTickerAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                // D-08：标签在后台时只空转，不计算、不渲染 —— 即不产生 SignalR 帧。
                // 放在 InvokeAsync 之前是关键：进了渲染上下文就必然会推一帧。
                if (isHidden) continue;

                await InvokeAsync(() =>
                {
                    if (isDisposed) return;

                    RefreshAll();
                    StateHasChanged();      // InvokeAsync 不会自动渲染，必须显式调用
                });
            }
        }
        catch (OperationCanceledException)
        {
            // 正常退出
        }
        catch (Exception)
        {
            // 电路已断开或渲染器已释放，静默退出，避免异常逃逸到线程池
        }
    }

    public void Dispose()
    {
        // D-19 陷阱：实现 IAsyncDisposable 后渲染器只调 DisposeAsync，
        // 这个方法会静默变成死代码 —— 由 DisposeAsync 首行显式调用，故保留。
        isDisposed = true;
        tickerCts?.Cancel();
        tickerCts?.Dispose();
        tickerCts = null;
    }

    // ---------- D-08：可见性回调 ----------

    /// <summary>
    /// JS 侧 visibilitychange 的唯一入口（wwwroot/js/lovetimer.js）。
    /// 注意：这里读的是 visibilityState 而不是 hidden —— e2e 的注入法只覆盖前者。
    /// 该回调由渲染器调度到同步上下文，故可直接 RefreshAll/StateHasChanged。
    /// </summary>
    [JSInvokable]
    public Task OnVisibilityChanged(string state)
    {
        isHidden = string.Equals(state, "hidden", StringComparison.OrdinalIgnoreCase);

        // 硬约束：回到前台必须"先补刷一次、再让 ticker 继续"。
        // 年份自愈（EnsureYearsFresh）依附于刷新 ——《现状》:113 的预警即此（P-014 依赖闭合）。
        if (!isHidden && !isDisposed)
        {
            RefreshAll();
            StateHasChanged();      // [JSInvokable] 不会自动渲染
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();   // 必须首行：先置 isDisposed、停 ticker，再走两次 await；
                     // 放在末尾时两个 await 之间 isDisposed 仍是 false，ticker 照常推帧。

        if (visModule is not null)
        {
            // 两发 interop 各自 try：若 unregister 抛出就跳过 DisposeAsync，
            // JS 侧对象引用表会漏一项（《21》C-25 实测）。
            // 也注意别把 visHandlerId 提前清零 —— unregister 传 0 会短路，监听卸不掉。
            try
            {
                await visModule.InvokeVoidAsync("unregister", visHandlerId);
            }
            catch (JSDisconnectedException) { /* 断线/关页，无需清理 */ }
            catch (ObjectDisposedException) { /* 电路已释放 */ }
            catch (JSException) { }

            try
            {
                await visModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (JSException) { }

            visModule = null;
        }

        visRef?.Dispose();
        visRef = null;
    }

    // ---------- 渲染 ----------

    /// <summary>三行同源的唯一汇聚点：事件回调（计算/恢复默认）与秒刷都必须走这里。
    /// 只刷一行会让另两行停在上一 tick（P-010，实测 [34,33,33]）。</summary>
    private void RefreshAll()
    {
        var now = DateTime.Now;     // 一次取时：三行主行/副行与年份列表同源
        EnsureYearsFresh(now.Year);

        foreach (var type in anchorDates.Keys)
        {
            Render(anchorDates[type], type, now);
        }
    }

    /// <summary>P-014：跨年自愈。仅当年份真的变了才重建（引用替换 → Blazor 只追加一项，已选值不受影响）。</summary>
    private void EnsureYearsFresh(int currentYear)
    {
        if (currentYear == yearsBuiltFor) return;      // 短路是必需的，不是优化：避免每秒重建列表 + diff 77 个 Option
        yearsBuiltFor = currentYear;
        years = Enumerable.Range(1950, currentYear - 1949).Select(v => v.ToString()).ToList();
    }

    /// <summary>now 必传：取时点必须唯一，否则"主行与副行同源"这条硬约束会退化成约定。</summary>
    private void Render(DateTime anchor, string type, DateTime now)
    {
        var elapsed = now - anchor;
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;    // 双保险：不展示负值
        }

        var info = elapsedTimes[type];
        info.ElapsedTime =
            $"{elapsed.Days} 天, {elapsed.Hours} 小时, {elapsed.Minutes} 分钟, {elapsed.Seconds} 秒";

        // 日历换算用未 clamp 的 (anchor, now)：anchor 恒为零点、now 含时分秒，now < anchor 时方法内兜底
        var (y, m, d) = CalendarElapsed(anchor, now);
        info.CalendarText = FormatCalendar(y, m, d);
    }

    /// <summary>按日历扣减：先满年、再满月、余数为天。now &lt; anchor 全 0。</summary>
    private static (int Years, int Months, int Days) CalendarElapsed(DateTime anchor, DateTime now)
    {
        if (now < anchor) return (0, 0, 0);

        int y = now.Year - anchor.Year;
        var t = anchor.AddYears(y);
        if (t > now) { y--; t = anchor.AddYears(y); }           // 周年未到，回退一年

        int m = (now.Year - t.Year) * 12 + now.Month - t.Month;
        var t2 = t.AddMonths(m);
        if (t2 > now) { m--; t2 = t.AddMonths(m); }             // 月纪念日未到，回退一月

        return (y, m, (now - t2).Days);
    }

    /// <summary>跳过所有零段；全零特殊处理；满年整年说法。</summary>
    private static string FormatCalendar(int y, int m, int d)
    {
        if (y == 0 && m == 0 && d == 0) return "不到 1 天";

        var parts = new List<string>(3);
        if (y > 0) parts.Add($"{y} 年");
        if (m > 0) parts.Add($"{m} 个月");
        if (d > 0) parts.Add($"{d} 天");

        // 满年且零月零天 → "N 年整"（周年当天的自然说法）
        if (y > 0 && m == 0 && d == 0) parts[^1] = $"{y} 年整";

        return string.Join(" ", parts);
    }

    // ---------- 日期联动 ----------

    private void RebuildDays()
    {
        if (!int.TryParse(selectedYear, out var y) || !int.TryParse(selectedMonth, out var m))
        {
            return;
        }

        var count = DateTime.DaysInMonth(y, m);
        days = Enumerable.Range(1, count).Select(d => d.ToString()).ToList();

        // 越界收敛：1/31 → 切到 2 月 → 收敛为 2 月最后一天
        if (!int.TryParse(selectedDay, out var d) || d < 1 || d > count)
        {
            selectedDay = days[^1];
        }
    }

    private void OnYearMonthChanged()
    {
        validationMessage = null;
        RebuildDays();     // 字段已在 @bind-Value 赋值阶段更新完毕
    }

    private void OnDayChanged()
    {
        validationMessage = null;   // 用户改了日，旧的报错信息应失效
    }

    // ---------- 计算 ----------

    private void ApplyCustomDate(string type)
    {
        validationMessage = null;

        // 1) 完整性
        if (!(int.TryParse(selectedYear, out var year) &&
              int.TryParse(selectedMonth, out var month) &&
              int.TryParse(selectedDay, out var day)))
        {
            validationMessage = "请先选择完整的年、月、日。";
            return;
        }

        // 2) 日期存在性（双保险：联动正常时不会走到这里）
        DateTime selectedDate;
        try
        {
            selectedDate = new DateTime(year, month, day);
        }
        catch (ArgumentOutOfRangeException)
        {
            validationMessage = "所选日期不存在，请检查年、月、日。";
            return;
        }

        // 3) 未来日期
        if (selectedDate > DateTime.Today)
        {
            validationMessage = "纪念日不能晚于今天，请重新选择。";
            return;
        }

        anchorDates[type] = selectedDate;
        RefreshAll();     // 三行同源重算：只刷一行会让另两行停在上一 tick（P-010）
        // 事件回调结束后 Blazor 自动重渲染，无需 StateHasChanged()
    }

    private void ResetAnchor(string type)
    {
        anchorDates[type] = timePoints[type];
        validationMessage = null;
        RefreshAll();
    }
}

<style>
    /* 副行：与上一条主行构成一个视觉块（桌面端主行下边距 20px → −14 ≈ 6px 间隔） */
    .timer-calendar {
        text-align: center;
        font-size: .85em;
        color: #e48bfa;        /* 显式写：与 .timer 的 #e48bfa 对齐；`inherit` 会拿到 body 的 #886D68，不是想要的副行色 */
        opacity: .65;
        line-height: 1.4;
        margin: -14px 0 12px;
    }

    /* 该断点 .timer-display 的 margin 是 8px */
    @@media (max-width: 520px) {
        .timer-calendar {
            margin: -4px 0 10px;
        }
    }

    .love-validation-tip {
        margin-top: 8px;
        text-align: center;
        font-size: .9em;
        color: #d83b01;
    }

    .love-reset-bar {
        display: flex;
        gap: .5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 4px;
    }
</style>
