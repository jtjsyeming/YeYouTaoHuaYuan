@page "/game_2048"
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Numerics
@using System.Text.Json
@using System.Text.Json.Serialization
@using jtjsym.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>2048</PageTitle>

<h1>2048</h1>

<div class="@(isRestoring ? "game-container session-loading" : "game-container")">
    @for (int row = 0; row < GridSize; row++)
    {
        <div class="row">
            @for (int col = 0; col < GridSize; col++)
            {
                @* P-020 预渲染骨架化：isRestoring 期间只渲染空块与空文本（**不摘 DOM** —— 那会让 16 个 .tile
                   在恢复窗口内消失，而 countTiles / readBoard 是 10 个 spec 的前置）。预渲染实例的
                   isRestoring 恒为 true（OnAfterRenderAsync 不执行）⇒ 首屏天然是 16 个空灰块，没有"假数字"。 *@
                <div class="tile @TileClass(isRestoring || board[row, col] == 0 ? 0 : board[row, col])">@(isRestoring ? "" : (board[row, col] == 0 ? "" : board[row, col].ToString()))</div>
            }
        </div>
    }
</div>

@if (isRestoring)
{
    <p class="session-tip">正在恢复对局…</p>
}

<div class="controls">
    <FluentButton Class="dir-btn dir-up" @onclick="MoveUp" Disabled="@(isGameOver || isRestoring)">⬆️</FluentButton>
    <div class="dir-row">
        <FluentButton Class="dir-btn" @onclick="MoveLeft" Disabled="@(isGameOver || isRestoring)">⬅️</FluentButton>
        <FluentButton Class="dir-btn" @onclick="MoveDown" Disabled="@(isGameOver || isRestoring)">⬇️</FluentButton>
        <FluentButton Class="dir-btn" @onclick="MoveRight" Disabled="@(isGameOver || isRestoring)">➡️</FluentButton>
    </div>
</div>

<p>分数：@(isRestoring ? "—" : Score.ToString())</p>
<p class="best-score">最高分：@BestScore</p>
<p><FluentButton Class="replay-btn" @onclick="OnReplayClicked" Disabled="@(isGameOver || isRestoring)">重玩</FluentButton></p>

@if (isGameOver)
{
    <div class="game-over">
        <h2>游戏结束</h2>
        <FluentButton Class="overlay-replay-btn" Appearance="Appearance.Accent" @onclick="OnReplayClicked" Disabled="@isRestoring">重玩</FluentButton>
    </div>
}

@code {
    private const int GridSize = 4;
    // 90/10 取值比例已随 D-01 迁入 Services/Game2048Core.FourSpawnPercent（单一来源）
    // 单块上界 MaxTileValue 亦已随 P-019 迁入 Game2048Core（同一处契约，连同 IsValidArchive 一起可单测）
    private int[,] board = new int[GridSize, GridSize];
    private Random random = new Random();
    private int Score = 0;

    // 最高分（D-16）：存 localStorage，键名带 jtjsym. 命名空间，供后续 Tetris 等复用同一约定
    private const string BestKey = "jtjsym.g2048.best";
    private int BestScore = 0;
    private bool isBestLoaded = false;     // 只在第一次交互渲染时读一次

    private bool isGameOver = false;

    // 对局进度会话保持（D-17）：存 sessionStorage（标签页会话级，关标签即清），与 best 的 localStorage 分工
    private const string SessionKey = "jtjsym.g2048.session";

    /// <summary>写闸门（D-17）：恢复流程开始前为 false。它同时承担两件事 ——
    /// ① 写闸门：预渲染/初始化那次 RestartGame 一律不写（否则用新开局冲掉存档）；
    /// ② 一次性判据：恢复只跑一次。
    /// 注意：它在恢复<b>开始</b>就放行，**不是** UI 门闸（那是 isRestoring，边界在恢复结束）；两者不可合并。
    /// 也不能靠 catch 兜底 —— 预渲染里 JS 调用抛的是 InvalidOperationException，不是 JSException。</summary>
    private bool isSessionReady;

    /// <summary>UI 门闸（P-006/P-009）：初值 <b>true</b>，恢复结束（无论成败）才置 false。
    /// 预渲染实例不会走到 OnAfterRenderAsync，故其 HTML 恒带 session-loading —— 这是 P-009 的缓解点。
    /// 真正的拦截靠各入口的代码守卫（Disabled / pointer-events 都挡不住程序化 click）；
    /// 与 isSessionReady 边界不同（一个在恢复开始、一个在恢复结束），**不可合并**。</summary>
    private bool isRestoring = true;

    /// <summary>组件已释放（切页/断线）：await 之后的 StateHasChanged 会抛 ObjectDisposedException</summary>
    private bool disposed;

    /// <summary>存档 DTO。Cells 可为 null —— 缺字段的合法 JSON 会走到这条分支，必须靠模式匹配挡掉而非 NRE。
    /// 用 { get; set; } 而非 init：反射反序列化零悬念（本项目无 source generator）。</summary>
    private sealed class SessionState
    {
        [JsonPropertyName("v")]     public int V { get; set; }
        [JsonPropertyName("cells")] public int[]? Cells { get; set; }
        [JsonPropertyName("score")] public int Score { get; set; }
    }

    /// <summary>存档内容校验（P-002/004/005/019）。判据、上界推导与已知残余全部落在
    /// <see cref="Game2048Core.IsValidArchive"/>（迁出组件才可单测）；此处只保留转发，
    /// 调用点语义不变 —— <b>结构闸</b>（版本 / 长度）仍在上面的模式匹配里。</summary>
    private static bool IsValidArchive(int[] cells, int score) => Game2048Core.IsValidArchive(cells, score);

    // 键盘：window 级 JS 监听的模块句柄与回调引用（详见 wwwroot/js/gamekeyboard.js）
    private IJSObjectReference? keyModule;
    private DotNetObjectReference<Game_2048>? keyRef;
    private int keyRegId;

    /// <summary>按数值映射配色类：0 → 空块（无文字），2048 以上 → tile-super</summary>
    private static string TileClass(int v) => v switch
    {
        0       => "tile-empty",
        <= 2048 => $"tile-{v}",
        _       => "tile-super"
    };

    /// <summary>一步棋的收尾。<b>落盘改为 await</b>（P-007）：StateHasChanged 排在 setItem 完成之后，
    /// 于是得到"渲染即已落盘"的不变式 —— 用户在页面上看到这一步，这一步就已经在存档里。
    /// 注意：这**不改变** setItem 的派发时刻（fire-and-forget 在第一个 await 前就派出去了），
    /// 所以"点完立刻刷新"的丢步率不会下降，那是 Blazor Server 的架构边界（事件可能还没到服务端）。</summary>
    private async Task AfterMove(int[,] boardBefore)
    {
        // 标准规则：棋盘无变化（未位移、未合并）时不生成新块
        if (!IsBoardChanged(boardBefore, board))
        {
            StateHasChanged();
            return;
        }

        UpdateBestScore();   // Score 已在 Merge 内累加完毕，此处判断破纪录（按钮与键盘共用）
        AddRandomTile();

        if (Game2048Core.IsGameOver(FlatBoard()))
        {
            isGameOver = true;
        }

        await SaveSessionAsync();
        if (disposed) return;   // 电路已释放：StateHasChanged 会抛 ObjectDisposedException
        StateHasChanged();
    }

    private static bool IsBoardChanged(int[,] before, int[,] after)
    {
        for (int row = 0; row < GridSize; row++)
        {
            for (int col = 0; col < GridSize; col++)
            {
                if (before[row, col] != after[row, col])
                    return true;
            }
        }
        return false;
    }

    /// <summary>棋盘 → 行主序扁平 16 格。与 SaveSessionAsync 里 cells 的写法同序
    /// （<c>i / GridSize, i % GridSize</c>），不会转置。</summary>
    private int[] FlatBoard()
    {
        var flat = new int[GridSize * GridSize];
        for (int row = 0; row < GridSize; row++)
        {
            for (int col = 0; col < GridSize; col++)
            {
                flat[row * GridSize + col] = board[row, col];
            }
        }
        return flat;
    }

    protected override void OnInitialized()
    {
        RestartGame();   // 初始化入口：不进守卫，也不代表任何用户意图
    }

    /// <summary>重玩的**唯一用户入口**（主按钮 + 遮罩按钮共用）。恢复窗口内的点击一律忽略：
    /// 按钮此时是禁用视觉态，程序化点击（FT-08 的 element.click()）也必须被挡住，故守卫放在这里。
    /// 注意：不能改成在 RestartGame 里判 isRestoring —— OnInitialized 也调它，一判就再也恢复不出残局。</summary>
    private void OnReplayClicked()
    {
        if (isRestoring) return;
        RestartGame();
    }

    private void RestartGame()
    {
        board = new int[GridSize, GridSize];
        Score = 0;
        AddRandomTile();
        AddRandomTile();

        isGameOver = false;

        _ = SaveSessionAsync();   // 覆盖为新局；初始化那次被 isSessionReady 闸门挡掉
    }

    private void AddRandomTile()
    {
        var emptyTiles = new List<(int, int)>();

        for (int row = 0; row < GridSize; row++)
        {
            for (int col = 0; col < GridSize; col++)
            {
                if (board[row, col] == 0)
                {
                    emptyTiles.Add((row, col));
                }
            }
        }

        if (emptyTiles.Count > 0)
        {
            var (row, col) = emptyTiles[random.Next(emptyTiles.Count)];
            // 90/10 的取值与常量都在 Game2048Core.SpawnValue 里（D-01 单一来源）
            board[row, col] = Game2048Core.SpawnValue(random);
        }
    }

    private async Task MoveLeft()
    {
        if (isGameOver || isRestoring) return;   // 结束后按钮与方向键共用同一守卫；恢复窗口内一律无效
        var before = (int[,])board.Clone();
        for (int row = 0; row < GridSize; row++)
        {
            var line = GetRow(row);
            var mergedLine = Game2048Core.Merge(line, ref Score);
            SetRow(row, mergedLine);
        }
        await AfterMove(before);
    }

    private async Task MoveRight()
    {
        if (isGameOver || isRestoring) return;
        var before = (int[,])board.Clone();
        for (int row = 0; row < GridSize; row++)
        {
            var line = GetRow(row).Reverse().ToArray();
            var mergedLine = Game2048Core.Merge(line, ref Score).Reverse().ToArray();
            SetRow(row, mergedLine);
        }
        await AfterMove(before);
    }

    private async Task MoveUp()
    {
        if (isGameOver || isRestoring) return;
        var before = (int[,])board.Clone();
        for (int col = 0; col < GridSize; col++)
        {
            var line = GetColumn(col);
            var mergedLine = Game2048Core.Merge(line, ref Score);
            SetColumn(col, mergedLine);
        }
        await AfterMove(before);
    }

    private async Task MoveDown()
    {
        if (isGameOver || isRestoring) return;
        var before = (int[,])board.Clone();
        for (int col = 0; col < GridSize; col++)
        {
            var line = GetColumn(col).Reverse().ToArray();
            var mergedLine = Game2048Core.Merge(line, ref Score).Reverse().ToArray();
            SetColumn(col, mergedLine);
        }
        await AfterMove(before);
    }

    private int[] GetRow(int row)
    {
        var line = new int[GridSize];
        for (int col = 0; col < GridSize; col++)
        {
            line[col] = board[row, col];
        }
        return line;
    }

    private void SetRow(int row, int[] line)
    {
        for (int col = 0; col < GridSize; col++)
        {
            board[row, col] = line[col];
        }
    }

    private int[] GetColumn(int col)
    {
        var line = new int[GridSize];
        for (int row = 0; row < GridSize; row++)
        {
            line[row] = board[row, col];
        }
        return line;
    }

    private void SetColumn(int col, int[] line)
    {
        for (int row = 0; row < GridSize; row++)
        {
            board[row, col] = line[row];
        }
    }

    // ───────────────────────── 最高分持久化（D-16）─────────────────────────

    /// <summary>破纪录即异步落盘；未破纪录不产生任何 interop 开销（绝大多数走子走这条返回）</summary>
    private void UpdateBestScore()
    {
        if (Score <= BestScore) return;    // 只增不减：重玩后 Score=0 自然不会覆盖
        BestScore = Score;
        _ = WriteBestAsync();
    }

    private async Task WriteBestAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", BestKey, BestScore);
        }
        catch (JSException) { }               // 存储被禁：本次会话内仍有效
        catch (JSDisconnectedException) { }   // 关页/断线
        catch (ObjectDisposedException) { }   // 电路已释放
    }

    // ───────────────────────── 对局进度会话保持（D-17）─────────────────────────

    /// <summary>每步有效移动后与"重玩"后落盘。<c>isSessionReady</c> 为 false 时一律不写 —— 见字段注释。</summary>
    private async Task SaveSessionAsync()
    {
        if (!isSessionReady) return;              // ★ 预渲染 / 恢复前：绝不写

        try
        {
            // 快照在第一个 await 之前完成 —— 故 fire-and-forget 晚完成也不会读到"后来的盘面"
            var cells = new int[GridSize * GridSize];
            for (int r = 0; r < GridSize; r++)
                for (int c = 0; c < GridSize; c++)
                    cells[r * GridSize + c] = board[r, c];

            var json = JsonSerializer.Serialize(new SessionState { V = 1, Cells = cells, Score = Score });
            await JS.InvokeVoidAsync("sessionStorage.setItem", SessionKey, json);
        }
        catch (JSException) { }                   // 隐私模式 / 配额超限
        catch (JSDisconnectedException) { }       // 切页/断线：此时往往已经写成功，丢失也不影响下一变更点
        catch (ObjectDisposedException) { }       // 电路已释放（与 WriteBestAsync 同口径）
    }

    // ───────────────────────── 键盘操作（D-02）─────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 仅交互实例会走到 firstRender=true，规避 ServerPrerendered 的预渲染实例
        if (!firstRender) return;

        // ① 读最高分：与键盘模块解耦，键盘将来怎么改都不影响它
        if (!isBestLoaded)
        {
            isBestLoaded = true;               // 先置位：读失败也不重试（避免每次渲染都打 interop）
            try
            {
                var raw = await JS.InvokeAsync<string?>("localStorage.getItem", BestKey);
                if (int.TryParse(raw, out var v) && v > 0) BestScore = v;
            }
            catch (JSException) { }            // 隐私模式/存储被禁：BestScore 保持 0，游戏零降级
            catch (JSDisconnectedException) { }

            StateHasChanged();                 // 预渲染首帧是 0，这一帧补成真实值
        }

        // ② 恢复对局（D-17）。代码顺序排在 ① 之后只是可读性（先有纪录、再恢复对局）；
        //    两者**已无正确性依赖** —— 恢复分支不再写 best（P-003），best 的唯一更新点是 AfterMove()。
        if (!isSessionReady)
        {
            isSessionReady = true;             // 先开闸：即使下面全失败，也不能永久不写
            try
            {
                var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", SessionKey);
                var st = json is null ? null : JsonSerializer.Deserialize<SessionState>(json);

                // 结构闸：嵌套属性模式 —— Cells 为 null（如 {"v":1}）时**匹配失败**而非 NRE。
                // 这里绝不能写成 `st is not { V: 1 } || st.Cells.Length != …`：NRE 不在下面的 catch 列表里，
                // 冒泡出 OnAfterRenderAsync 会被 Blazor Server 判为未处理异常 → 直接断开 circuit。
                if (st is { V: 1, Cells.Length: GridSize * GridSize })
                {
                    if (!IsValidArchive(st.Cells!, st.Score))
                    {
                        // 内容闸：非法档（P-002 值域/分数、P-004 空盘、P-005 非 2 幂）清掉，避免每次进页面重复拒绝；
                        // 棋盘保持 OnInitialized 的新局
                        await JS.InvokeVoidAsync("sessionStorage.removeItem", SessionKey);
                    }
                    else
                    {
                        var cells = st.Cells!;     // 长度模式已通过 ⇒ 非 null
                        for (int i = 0; i < cells.Length; i++)
                            board[i / GridSize, i % GridSize] = cells[i];

                        Score = st.Score;
                        isGameOver = Game2048Core.IsGameOver(FlatBoard()); // 重算，不信任存档；死局自然出遮罩
                        // 此处**不再**调用 UpdateBestScore()（P-003）：存档分不得抬升永久纪录。
                        // 单靠这一句删除并不够 —— 若 Score 里留着 999999，玩家走一步仍会经 AfterMove 写入，
                        // 故伪造分必须在闸一就被拒（分数可证上界）。
                        StateHasChanged();         // 预渲染首帧是新局，这一帧必须刷成恢复态
                    }
                }
                // 无存档 / 版本不符 / 长度不符 / 损坏 → 保持 OnInitialized 的初始新局，静默（D-17 语义不变）
            }
            catch (JSException) { }
            catch (JsonException) { }          // 半截 JSON
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            finally
            {
                // UI 门闸在恢复**结束**才解除（与写闸门 isSessionReady 的边界不同）。
                // 必须放在 finally：任何一条失败路径都不能把页面永久卡在"正在恢复"。
                isRestoring = false;
                if (!disposed) StateHasChanged();
            }
        }

        // ③ 键盘注册（原逻辑，保持不变）
        if (keyModule is not null) return;

        keyRef = DotNetObjectReference.Create(this);
        keyModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/gamekeyboard.js");

        // 复检：import 期间组件可能已被销毁，而那时 DisposeAsync 看到 keyModule 还是 null，
        // 什么都没卸。若此时继续 register，register() 首句 removeListeners() 会拆掉新页刚装上的监听
        // 并把 currentId 换成自己的 —— activeRef 指向一个已 Dispose 的 DotNetObjectReference。
        // 注意：只能收窄窗口，不能证明消除；D02-9 守的是最终归属。
        if (disposed)
        {
            try { await keyModule.DisposeAsync(); }
            catch (JSDisconnectedException) { } catch (ObjectDisposedException) { } catch (JSException) { }
            keyModule = null;
            keyRef.Dispose();
            keyRef = null;
            return;
        }

        // 2048：一次按键 = 一步，忽略连发（按住 ← 连发会连吃新块、分数乱涨）
        keyRegId = await keyModule.InvokeAsync<int>("register", keyRef,
            new { repeatKeys = Array.Empty<string>() });
    }

    /// <summary>
    /// 注意：[JSInvokable] 不会自动重渲染（与 @onclick 不同）。
    /// 四个 MoveX() 经 AfterMove 内部各自 StateHasChanged()，故这里不再额外触发，避免双帧渲染。
    /// <para>lambda 必须写成 <c>async () => …</c> 并逐个 await：MoveXxx 改成 async Task 后，
    /// 无返回值的 lambda 会被重载解析绑到 <c>InvokeAsync(Action)</c>，Task 被丢弃，
    /// await 形同虚设（不报错、不警告），落盘又退回 fire-and-forget。</para>
    /// </summary>
    [JSInvokable]
    public Task OnKeyDown(string key) => InvokeAsync(async () =>
    {
        switch (key)
        {
            case "ArrowLeft":  await MoveLeft();  break;
            case "ArrowRight": await MoveRight(); break;
            case "ArrowUp":    await MoveUp();    break;
            case "ArrowDown":  await MoveDown();  break;
        }
    });

    [JSInvokable]
    public Task OnKeyUp(string key) => Task.CompletedTask;   // 2048 无 keyup 需求，接口占位

    public async ValueTask DisposeAsync()
    {
        disposed = true;   // 先置位：此后任何 await 回来的 AfterMove/恢复分支都不再渲染
        if (keyModule is not null)
        {
            // 两发 interop 各自 try：若 unregister 抛出，不能连带跳过 DisposeAsync ——
            // 否则 keyModule 被置 null，JS 侧对象引用表会漏一项
            try
            {
                await keyModule.InvokeVoidAsync("unregister", keyRegId);
            }
            catch (JSDisconnectedException) { /* 断线/关页，无需清理 */ }
            catch (ObjectDisposedException) { /* 电路已释放 */ }
            catch (JSException) { /* 防御性：本方法的两发 interop 都不该抛 JSException，与 SaveSessionAsync 等其余三处的四件套保持同口径 */ }

            try
            {
                await keyModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (JSException) { }
            keyModule = null;
        }
        keyRef?.Dispose();
        keyRef = null;
    }
}

