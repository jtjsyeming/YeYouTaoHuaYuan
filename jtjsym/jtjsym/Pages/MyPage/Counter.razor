@page "/counter"
@using Microsoft.FluentUI.AspNetCore.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>按下试试</PageTitle>

<h1>按下试试</h1>

<p role="status">本次功德：@knockCount</p>

<style>
	.muyu-btn {
		width: 48px;
		height: 48px;
		background-image: url('Images/counter.gif'); /* 木鱼图片路径 */
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		border: none;
		border-radius: 50%; /* 让按钮变成圆形 */
		cursor: pointer;
		outline: none;
		transition: transform 0.1s ease; /* 点击效果过渡 */
		touch-action: manipulation; /* 禁双击缩放、禁长按选择，移动端连点必踩 */
		-webkit-tap-highlight-color: transparent; /* Android 点按高亮块会与 :active 放大叠加发闪 */
	}

		.muyu-btn:active {
			transform: scale(1.1); /* 点击时放大 */
		}

	/* 按钮下移到视口约 1/3 处（《29》§3.3 的 R1）。
	   227 ≈ 内容栈 114 的一半 + 余量，是"落点旋钮"，不影响正确性；
	   若日后 h1 / 本次功德行增减，重跑 FISH-10 三档即可发现。
	   用 dvh 不用 vh：移动端地址栏展开时 100vh 比可视区高（同 D-14 / 《23》的教训）。 */
	.muyu-stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: calc(66.7dvh - 227px);
	}

	/* 左右两枚装饰与按钮必须同处一行：若它们也当 stage 的独立 flex item，
	   column 方向会堆成「左 / 按钮 / 右」三行，按钮反而横向跑偏。
	   行高由 48px 按钮决定（装饰盒 26px 在 align-items:center 下不撑高），
	   所以纵向尺寸与只放上下两枚时完全一致，按钮中心不动。 */
	.muyu-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	/* 装饰图标的外层盒（FluentIcon 渲染成 <div style="display:inline-block"><img></div>）。
	   img 是行内元素，盒高被基线下空隙撑成 26px（24 图标 + 2），且 img 偏下 2px ——
	   实测四向间隙是「上 0 / 下 2 / 左右 +1」，不对称。
	   改 flex 居中即四向一致（上下各 1px、左右 0）。
	   display 必须 !important：FluentIcon 把 display: inline-block 写在内联 style 上，
	   样式表压不住；height 等无内联冲突，不需要。
	   高度钉 26px 使纵向总高仍是 100（26+48+26），按钮中心不动，
	   FISH-10 的落点基线不受影响。改 Width="24px" 时 26 要同步。 */
	.muyu-stage > div:not(.muyu-row),
	.muyu-row > div {
		display: flex !important;
		align-items: center;
		justify-content: center;
		height: 26px;
	}
</style>

@* 四向装饰（C-49）：上 → 左 → 按钮 → 右 → 下，围绕按钮呈十字对称。
   装饰节点一律在 stage 内：只包按钮的话它们会各自落到 stage 的上下两端（相隔约 490px），
   视觉上像"飞出去了"；放进 stage 则紧贴按钮、对称。
   （初始 ShowImage=false 时 stage 内只有按钮，与《29》§3.2 的落点基线完全等价。） *@
<div class="muyu-stage">
	@if (ShowImage)
	{
		<FluentIcon Value="@(Icon.FromImageUrl("Images/counter.gif"))" Width="24px" />
	}

	<div class="muyu-row">
		@if (ShowImage)
		{
			<FluentIcon Value="@(Icon.FromImageUrl("Images/counter.gif"))" Width="24px" />
		}

		<FluentButton IconEnd="@(new Icons.Filled.Size32.AnimalPawPrint().WithColor("#7D8E89"))"
					  class="muyu-btn" @onclick="KnockWoodenFish" @onmouseout="StopKnocking">
		</FluentButton>

		@if (ShowImage)
		{
			<FluentIcon Value="@(Icon.FromImageUrl("Images/counter.gif"))" Width="24px" />
		}
	</div>

	@if (ShowImage)
	{
		<FluentIcon Value="@(Icon.FromImageUrl("Images/counter.gif"))" Width="24px" />
	}
</div>

@code {
	private int knockCount = 0;
	private bool ShowImage { get; set; } = false;

	// 「功德+1」飘字模块（C-48）。视觉完全由 JS 侧事件委托驱动，
	// 这里只负责 import / register / unregister —— 注册失败也只是没有飘字，计数照常。
	private IJSObjectReference? module;
	private bool isDisposed;

	private void KnockWoodenFish()
	{
		ShowImage = true;
		IncrementKnock();
	}

	private void StopKnocking()
	{
		ShowImage = false;
	}

	private void IncrementKnock()
	{
		knockCount++;
	}

	// ---------- 飘字模块的生命周期（C-48）----------

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// ServerPrerendered 下 OnAfterRenderAsync 只在交互实例执行（预渲染实例不跑），
		// 因此 firstRender 即"真实例首次渲染"，注册一次即可；module != null 兼作幂等护栏。
		if (!firstRender || module is not null) return;

		try
		{
			module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/woodfish.js");
		}
		catch (JSDisconnectedException) { return; }
		catch (ObjectDisposedException) { return; }
		catch (JSException) { return; }

		// 复检：import 期间组件可能已被销毁（DisposeAsync 当时 module 还是 null，什么都没卸）
		if (isDisposed)
		{
			await SafeReleaseAsync(module);
			module = null;
			return;
		}

		try { await module.InvokeVoidAsync("register"); }
		catch (JSDisconnectedException) { }
		catch (ObjectDisposedException) { }
		catch (JSException) { }
	}

	private static async Task SafeReleaseAsync(IJSObjectReference m)
	{
		try { await m.DisposeAsync(); }
		catch (JSDisconnectedException) { }
		catch (ObjectDisposedException) { }
		catch (JSException) { }
	}

	public async ValueTask DisposeAsync()
	{
		isDisposed = true;                       // 先置位，OnAfterRenderAsync 的复检才有效
		if (module is null) return;

		// 两发 interop 各自四件套，不能合并（D-19 的教训：前者抛出会连带跳过后者）
		try { await module.InvokeVoidAsync("unregister"); }
		catch (JSDisconnectedException) { }
		catch (ObjectDisposedException) { }
		catch (JSException) { }

		await SafeReleaseAsync(module);
		module = null;
	}
}
