<FluentPage>
    <FluentPageHeader>
        <FluentTextBlock Class="problem-description">
            @ProblemDescription
        </FluentTextBlock>
    </FluentPageHeader>

    @* <FluentSection>
        <FluentSectionHeader>
            <FluentSectionHeaderTitle>我的代码</FluentSectionHeaderTitle>
        </FluentSectionHeader>
        <FluentCodeBlock Language="cpp" Code=@CodeAnswer></FluentCodeBlock>
    </FluentSection>

    <FluentSection>
        <FluentSectionHeader>
            <FluentSectionHeaderTitle>输入输出示例</FluentSectionHeaderTitle>
        </FluentSectionHeader>
        <FluentSection>
            <FluentSectionHeader>
                <FluentSectionHeaderTitle>输入</FluentSectionHeaderTitle>
            </FluentSectionHeader>
