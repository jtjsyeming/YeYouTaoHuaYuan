@page "/coding_place"
@using Microsoft.FluentUI.AspNetCore.Components
@using System.Text

<PageTitle>编程挑战</PageTitle>

<h1>编程挑战</h1>

<FluentCard Style="max-width:880px;margin:0 auto;text-align:left">
    <h2 style="margin-top:0">任务混部</h2>
    <pre class="problem-description">@ProblemDescription</pre>

    <details class="code-answer">
        <summary>参考答案（点击展开）</summary>
        <pre class="code-answer-pre">@CodeAnswer.Trim()</pre>
    </details>

</FluentCard>

@code {
    // 在这里填充问题描述
    private readonly string ProblemDescription = @"
        问题描述:
        公司创新实验室正在研究如何最小化资源成本，最大化资源利用率。现在需要解决一个任务混部问题，具体如下：
        给定一批任务，每个任务有以下属性：
        • 开始时间（startTime）：任务开始运行的时间。
        • 结束时间（endTime）：任务结束运行的时间。
        • 并行度（parallelism）：任务运行时占用的服务器数量。
        任务运行完成后会立即释放占用的服务器（结束时刻不占用服务器）。任务混部问题的目标是计算完成这批任务所需的最少服务器数量，从而最大化控制资源成本。
        输入描述
        输入包含多行：
        1. 第一行输入一个整数taskNum，表示任务的总数。
        2. 接下来taskNum行，每行包含三个整数，分别表示任务的开始时间（startTime）、结束时间（endTime）和并行度（parallelism）。
        输出描述:
        输出一个整数，表示完成这批任务所需的最少服务器数量。
    ";

    // 在这里填充你的代码答案
    private readonly string CodeAnswer = $@"
        #include <iostream>
        #include <vector>
        #include <queue>
        #include <algorithm>
        using namespace std;
        struct Task {{
            int startTime;
            int endTime;
            int parallelism;
        Task(int start, int end, int parallel) : startTime(start), endTime(end), parallelism(parallel) {{}}
        // 用于按任务的开始时间排序
            bool operator<(const Task& other) const {{
                return startTime < other.startTime;
            }}
        }};
        int minServers(vector<Task>& tasks) {{
            // 按任务的开始时间排序
            sort(tasks.begin(), tasks.end());
        // 优先队列，存储每个服务器的释放时间
            priority_queue<int, vector<int>, greater<int>> availableServers;
        // 遍历每个任务
            for (const auto& task : tasks) {{
                // 检查是否有服务器可以复用
                while (!availableServers.empty() && availableServers.top() <= task.startTime) {{
                    availableServers.pop();
                }}
        // 更新服务器的释放时间
                for (int i = 0; i < task.parallelism; ++i) {{
                    availableServers.push(task.endTime);
                }}
            }}
        // 优先队列的大小即为所需的最少服务器数量
            return availableServers.size();
        }}
        int main() {{
            int taskNum;
            cin >> taskNum;
        vector<Task> tasks;
            for (int i = 0; i < taskNum; ++i) {{
                int start, end, parallel;
                cin >> start >> end >> parallel;
                tasks.emplace_back(start, end, parallel);
            }}
        int result = minServers(tasks);
            cout << result << endl;
        return 0;
        }}
    ";
}

<style>
    /* H-009：题面的 pre 元素没有任何 CSS（实测 color rgb(33,33,33)、背景透明、无 padding），
       折叠区样式必须自带；类名带 code-answer 前缀，避免与全站通用类冲突（H-004 的教训）。 */
    .code-answer { margin-top: 16px; }
    .code-answer > summary { cursor: pointer; font-weight: 600; color: #1b6ec2; }
    .code-answer-pre {
        background: #f6f8fa;
        border: 1px solid #e1e4e8;
        border-radius: 6px;
        padding: 12px;
        overflow-x: auto;
        font-family: SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 13px;
        line-height: 1.45;
        color: #24292f;      /* 显式给色：不写会继承 body 的 #886D68（H-010 之后 body 才有 color） */
        text-align: left;    /* 同上：body{text-align:center} 会继承进 pre */
    }
</style>
