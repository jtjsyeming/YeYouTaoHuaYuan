{
  "version": "2.0.0",
  "tasks": [
    {
      // 构建 jtjsym 网站（Ctrl+Shift+B 的第一个选项）
      "label": "build-jtjsym",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/jtjsym/jtjsym.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jtjsym"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      // 不调试直接运行 jtjsym 网站；--no-launch-profile 跳过 launchSettings.json 里缺证书的 https 地址
      "label": "run-jtjsym",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/jtjsym/jtjsym/jtjsym.csproj",
        "--no-launch-profile",
        "--urls",
        "http://localhost:14074"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jtjsym/jtjsym",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "dependsOn": "build-jtjsym",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      // F5 前的准备：先清掉上次调试残留的进程（它们会占住 14074），再编译
      "label": "prep-jtjsym",
      "dependsOn": ["kill-stale-jtjsym", "build-jtjsym"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // 结束仍在监听 14074 的残留 jtjsym 进程，避免 "address already in use"
      "label": "kill-stale-jtjsym",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-NetTCPConnection -LocalPort 14074 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { try { $p = Get-Process -Id $_ -ErrorAction Stop; Stop-Process -Id $p.Id -Force -ErrorAction Stop; Write-Host ('已结束残留进程: ' + $p.ProcessName + ' (PID ' + $p.Id + ')') } catch { } }; exit 0"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      // F5「手机浏览器 / 局域网」前的准备：清 14075 残留 → 编译 → 打印手机该输的地址
      "label": "prep-jtjsym-mobile",
      "dependsOn": ["kill-stale-jtjsym-mobile", "build-jtjsym", "show-lan-url"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // 结束仍在监听 14075 的残留 jtjsym 进程（与桌面那条的 14074 互不干扰）
      "label": "kill-stale-jtjsym-mobile",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-NetTCPConnection -LocalPort 14075 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { try { $p = Get-Process -Id $_ -ErrorAction Stop; Stop-Process -Id $p.Id -Force -ErrorAction Stop; Write-Host ('已结束残留进程: ' + $p.ProcessName + ' (PID ' + $p.Id + ')') } catch { } }; exit 0"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      // 打印手机访问地址：局域网 IP 是 DHCP 分配，会随换网络变化，所以每次现查而不能写死
      "label": "show-lan-url",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$port = 14075; $fw = 'jtjsym dev 14075 (LAN)'; $nl = [Environment]::NewLine; $o = @(); $ips = @(Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254.*' } | Select-Object -ExpandProperty IPAddress -Unique); $o += ('=== 手机浏览器访问（手机与电脑连同一个 Wi-Fi）=== 端口 ' + $port); if ($ips.Count -eq 0) { $o += '  未找到局域网 IP，请检查网络连接' } else { foreach ($ip in $ips) { $o += ('  http://' + $ip + ':' + $port) } }; $o += ''; $o += ('  本机预览：http://localhost:' + $port); if (Get-NetFirewallRule -DisplayName $fw -ErrorAction SilentlyContinue) { $o += '  防火墙：已放行（仅专用网络）' } else { $o += '  防火墙：未放行，手机连不上时用管理员 PowerShell 执行一次：'; $o += '    New-NetFirewallRule -DisplayName ''jtjsym dev 14075 (LAN)'' -Direction Inbound -Action Allow -Protocol TCP -LocalPort 14075 -Profile Private' }; $o += '  站点起来后再点（首次编译要几秒）'; $o += '  手机还不行就查：网络位置须为「专用」、别连隔离的访客网络'; Write-Host ($nl + ($o -join $nl) + $nl); exit 0"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // 清理网站的编译输出（MineSweeper 已于 H-013 前置清理中删除，原第二条 clean 同步移除）
      "label": "clean-all",
      "type": "shell",
      "command": "dotnet clean \"${workspaceFolder}/jtjsym/jtjsym.sln\"",
      "problemMatcher": []
    },
    {
      // ★ 一键发布：先发到 .publish/staging，成功后再镜像同步到部署目录
      //   顺序执行，任何一步失败都不会动到部署目录
      "label": "publish-jtjsym",
      "dependsOn": ["publish-jtjsym-dotnet", "publish-jtjsym-sync"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      // ★ 发布新版本：发布 + 同步到发布目录 + 同步到部署目录 + 自动按版本号打 zip 备份
      //   版本号由 .vscode/publish-release.ps1 自动取备份目录里最大版本 +1
      "label": "release-jtjsym",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/publish-release.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      // 步骤 1/2：Release + win-x64 + 框架依赖 + 单文件关闭，输出到暂存目录
      "label": "publish-jtjsym-dotnet",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/jtjsym/jtjsym/jtjsym.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:PublishSingleFile=false",
        "-o",
        "${workspaceFolder}/.publish/staging"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jtjsym"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      // 步骤 2/2：/MIR 镜像同步——覆盖更新文件，并删除部署目录里已过期的旧 dll
      // 想换部署目录，只改下面 -Command 里的 $dst 路径即可
      "label": "publish-jtjsym-sync",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$src = Join-Path '${workspaceFolder}' '.publish\\staging'; $dst = 'E:\\300programing\\390Publish\\391jtjsym'; if (-not (Test-Path -LiteralPath $src)) { Write-Host '源目录不存在:' $src; exit 1 }; robocopy $src $dst /MIR /NFL /NDL /NJH /NP /R:2 /W:1; if ($LASTEXITCODE -ge 8) { exit 1 } else { exit 0 }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
