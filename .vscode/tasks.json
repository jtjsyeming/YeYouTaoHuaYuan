{
  "version": "2.0.0",
  "tasks": [
    {
      // 构建 jtjsym 网站（Ctrl+Shift+B 的第一个选项）
      "label": "build-jtjsym",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/jtjsym/jtjsym.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jtjsym"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      // 构建 MineSweeper 桌面程序
      "label": "build-minesweeper",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MineSweeper/MineSweeper.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "options": {
        "cwd": "${workspaceFolder}/MineSweeper"
      },
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      // 不调试直接运行 jtjsym 网站；--no-launch-profile 跳过 launchSettings.json 里缺证书的 https 地址
      "label": "run-jtjsym",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/jtjsym/jtjsym/jtjsym.csproj",
        "--no-launch-profile",
        "--urls",
        "http://localhost:14074"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jtjsym/jtjsym",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "dependsOn": "build-jtjsym",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      // 清理两个工程的输出
      "label": "clean-all",
      "type": "shell",
      "command": "dotnet clean \"${workspaceFolder}/jtjsym/jtjsym.sln\" && dotnet clean \"${workspaceFolder}/MineSweeper/MineSweeper.csproj\"",
      "problemMatcher": []
    },
    {
      // ★ 一键发布：先发到 .publish/staging，成功后再镜像同步到部署目录
      //   顺序执行，任何一步失败都不会动到部署目录
      "label": "publish-jtjsym",
      "dependsOn": ["publish-jtjsym-dotnet", "publish-jtjsym-sync"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      // ★ 发布新版本：发布 + 同步到发布目录 + 同步到部署目录 + 自动按版本号打 zip 备份
      //   版本号由 .vscode/publish-release.ps1 自动取备份目录里最大版本 +1
      "label": "release-jtjsym",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/publish-release.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      // 步骤 1/2：Release + win-x64 + 框架依赖 + 单文件关闭，输出到暂存目录
      "label": "publish-jtjsym-dotnet",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/jtjsym/jtjsym/jtjsym.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:PublishSingleFile=false",
        "-o",
        "${workspaceFolder}/.publish/staging"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jtjsym"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    },
    {
      // 步骤 2/2：/MIR 镜像同步——覆盖更新文件，并删除部署目录里已过期的旧 dll
      // 想换部署目录，只改下面 -Command 里的 $dst 路径即可
      "label": "publish-jtjsym-sync",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$src = Join-Path '${workspaceFolder}' '.publish\\staging'; $dst = 'E:\\300programing\\390Publish\\391jtjsym'; if (-not (Test-Path -LiteralPath $src)) { Write-Host '源目录不存在:' $src; exit 1 }; robocopy $src $dst /MIR /NFL /NDL /NJH /NP /R:2 /W:1; if ($LASTEXITCODE -ge 8) { exit 1 } else { exit 0 }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
