{
  "name": "jtjsym-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "夜游桃花源（jtjsym）Playwright 端到端回归套件，仅用于开发期测试",
  "scripts": {
    "test:smoke": "playwright test tests/smoke.spec.mjs",
    "test:nav": "playwright test tests/nav_fish.spec.mjs tests/d11_d12.spec.mjs --grep \"NAV-[0-9]|D-11\"",
    "test:fish": "playwright test tests/nav_fish.spec.mjs --grep \"FISH-[0-9]\"",
    "test:lt": "playwright test tests/lt.spec.mjs",
    "test:g2048": "playwright test tests/g2048.spec.mjs",
    "test:tris": "playwright test tests/tris.spec.mjs",
    "test:code": "playwright test tests/code_nf.spec.mjs --grep \"CODE-[0-9]\"",
    "test:nf": "playwright test tests/code_nf.spec.mjs tests/d11_d12.spec.mjs --grep \"NF-[0-9]|D-1[12]\"",
    "test:d11d12": "playwright test tests/d11_d12.spec.mjs",
    "test:d02": "playwright test tests/d02_keyboard_ui.spec.mjs",
    "test:d14": "playwright test tests/d14_mobile_layout.spec.mjs",
    "test:d15": "playwright test tests/d15_home_fluent.spec.mjs",
    "test:d01": "playwright test tests/d01_spawn.spec.mjs",
    "test:fast": "playwright test tests/nav_fish.spec.mjs tests/lt.spec.mjs tests/g2048.spec.mjs tests/code_nf.spec.mjs tests/d11_d12.spec.mjs",
    "test:all": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
