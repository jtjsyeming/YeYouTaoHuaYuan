{
  "name": "jtjsym-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "夜游桃花源（jtjsym）Playwright 端到端回归套件，仅用于开发期测试",
  "scripts": {
    "test:smoke": "playwright test tests/smoke.spec.mjs",
    "test:nav": "playwright test tests/nav_fish.spec.mjs tests/d11_d12.spec.mjs --grep \"NAV-[0-9]|D-11\"",
    "test:fish": "playwright test tests/nav_fish.spec.mjs --grep \"FISH-[0-9]\"",
    "test:lt": "playwright test tests/lt.spec.mjs",
    "test:g2048": "playwright test tests/g2048.spec.mjs",
    "test:tris": "playwright test tests/tris.spec.mjs",
    "test:code": "playwright test tests/code_nf.spec.mjs --grep \"CODE-[0-9]\"",
    "test:nf": "playwright test tests/code_nf.spec.mjs tests/d11_d12.spec.mjs --grep \"NF-[0-9]|D-1[12]\"",
    "test:d11d12": "playwright test tests/d11_d12.spec.mjs",
    "test:d02": "playwright test tests/d02_keyboard_ui.spec.mjs",
    "test:d14": "playwright test tests/d14_mobile_layout.spec.mjs",
    "test:d15": "playwright test tests/d15_home_fluent.spec.mjs",
    "test:d01": "playwright test tests/d01_spawn.spec.mjs",
    "test:d16": "playwright test tests/d16_best_score.spec.mjs",
    "test:d22": "playwright test tests/d22_tetris_best.spec.mjs",
    "test:d24": "playwright test tests/d24_tetris_session.spec.mjs",
    "test:ms": "playwright test tests/minesweeper.spec.mjs",
    "test:llk": "playwright test tests/lianliankan.spec.mjs",
    "test:d03": "playwright test tests/d03_calendar.spec.mjs",
    "test:d17": "playwright test tests/d17_session.spec.mjs",
    "test:d18": "playwright test tests/d18_archive_guard.spec.mjs",
    "test:d19": "playwright test tests/d19_restore_gate.spec.mjs",
    "test:d20": "playwright test tests/d20_lt_consistency.spec.mjs",
    "test:d08": "playwright test tests/d08_visibility.spec.mjs",
    "test:fast": "playwright test tests/nav_fish.spec.mjs tests/lt.spec.mjs tests/g2048.spec.mjs tests/code_nf.spec.mjs tests/d11_d12.spec.mjs tests/d22_tetris_best.spec.mjs tests/d24_tetris_session.spec.mjs",
    "test:pr": "playwright test --project=chromium --grep \"NAV-|FISH-|G2048-|LT-|TRIS-0|D14-|D08-|D02-|D-1[12]|D15-|NF-|CODE-|D22-|D24-|MS-|LL-\"",
    "test:unit": "dotnet test ../../jtjsym/jtjsym.Tests/jtjsym.Tests.csproj --nologo",
    "test:all": "npm run test:unit && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
